#!/usr/bin/env bash
# shellcheck shell=bash
# =============================================================================
#  ailease — 一次性 AI 环境管理器（容器优先，宿主机账号兜底）
# =============================================================================
#  合并自两个独立工具：
#    · 容器方案（原 aidocker）：起一个用完即焚的容器，容器内 root，
#      能碰到的只有你挂进去的那一个目录，到期自动停、一键连容器带数据删掉。
#    · 账号方案（原 aiuser.sh）：建一个限时 + 限权 + 限目录的宿主机账号，
#      POSIX ACL 限目录、sudo 白名单、到期自动禁用、事后一键吊销。
#
#  两个版本，同一套命令与参数，运行时自动判断用哪个：
#    · 容器版（docker 可用）：sudo ailease install docker 装好 docker 引擎与基础镜像
#    · 账号版（兜底）：sudo ailease install 装好主程序、护栏与回收器，不依赖 docker
#
#  快速开始
#    sudo ./ailease install                     # 主程序 + 账号版（不碰 docker）
#    sudo ./ailease install docker              # 追加 docker 版，启用容器模式
#    sudo ailease new ai /clicd 2h              # 自动选版本（docker 可用走容器）
#    sudo ailease new ai /clicd 2h --host       # 强制账号版
#    sudo ailease new ai /clicd 2h --container  # 强制容器版
#    sudo ailease list
#    sudo ailease exec ai
#    sudo ailease del ai
#
#  三条铁律（容器模式，脚本已强制）
#    1. 不挂 /var/run/docker.sock    2. 不用 --privileged / host 网络或 pid
#    3. 不挂 /、/etc、/root、/home 等宿主目录本体
#
#  ⚠ 信任边界：--host 的 sudo 白名单只约束命令名，约束不了命令内部行为；
#    即便 minimal 档（chmod/chown/cp/tee/find/tar 等）也等价于 root 级文件访问。
#    要目录级隔离用容器模式；要对抗性沙箱请上独立 VM。
# =============================================================================

set -Eeuo pipefail

VERSION="2.0.0"
SELF_DEST="/usr/local/sbin/ailease"
AIRM_DEST="/usr/local/sbin/ailease-rm"
# 管道执行（wget … | bash）时脚本不在文件系统上，靠这个地址回取自身
SELF_URL="${AILEASE_URL:-https://cikeblog.com/ailease}"

CONF_DIR="/etc/ailease"
CONF_FILE="$CONF_DIR/config"
LIB_DIR="/var/lib/ailease"
C_META_DIR="$LIB_DIR/containers"      # 容器元数据
H_USERS_DIR="$LIB_DIR/users"          # 宿主机账号元数据
ARCHIVE_DIR="$LIB_DIR/archive"        # 账号家目录归档
LOG_DIR="/var/log/ailease"
AUDIT_LOG="$LOG_DIR/audit.log"
LOCK_FILE="$LIB_DIR/.lock"

SSHD_MAIN="/etc/ssh/sshd_config"
REAPER_SVC="/etc/systemd/system/ailease-reaper.service"
REAPER_TIMER="/etc/systemd/system/ailease-reaper.timer"
REAPER_CRON="/etc/cron.d/ailease"
LOGROTATE_CONF="/etc/logrotate.d/ailease"
NAME_PREFIX="ailease-"

# ------------------------------------------------------------------- 可调默认
DEFAULT_MODE="auto"                # auto | container | host —— new 的默认版本
DEFAULT_DURATION="24h"
DEFAULT_PROFILE="minimal"          # minimal | dev | ops | none
DEFAULT_WORKROOT="/srv/aiwork"
DEFAULT_SHELL="/bin/bash"
PURGE_ON_EXPIRE="no"               # yes = 到期归档后删除账号 / 删除容器
KILL_ON_EXPIRE="yes"               # yes = 账号到期立即踢掉在线会话
REAPER_INTERVAL_SEC=60
INSTALL_DOCKER="yes"               # install 时是否尝试自动装 docker

# 容器默认
BASE_IMAGE="4kerccc/aidocker-base:bookworm"
BUILTIN_IMAGE="$BASE_IMAGE"        # 脚本内置默认值；升级时用它同步旧配置
DEFAULT_IMAGE="$BASE_IMAGE"
DEFAULT_BIND="127.0.0.1"
# 资源默认值按宿主机实况推算：写死大值会在小内存机器上直接起不来
_host_mem_mb="$(awk '/^MemTotal:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)"
if (( _host_mem_mb > 0 )); then
  _quarter=$(( _host_mem_mb / 4 ))
  (( _quarter < 128 )) && _quarter=128
  (( _quarter > 2048 )) && _quarter=2048
  DEFAULT_MEM="${_quarter}m"
else
  DEFAULT_MEM="1g"
fi
_host_cpu="$(nproc 2>/dev/null || echo 1)"
if (( _host_cpu < 2 )); then DEFAULT_CPUS="$_host_cpu"; else DEFAULT_CPUS="2"; fi
DEFAULT_PIDS="512"

[ -r "$CONF_FILE" ] && . "$CONF_FILE" || true

# 本次运行是否尝试装 docker（--no-docker 关闭）
WANT_DOCKER="$INSTALL_DOCKER"

# --------------------------------------------------------------------- 运行时
DRY_RUN="no"
QUIET="no"
COLOR="no"
[[ -t 1 ]] && COLOR="yes"

if [[ $COLOR == yes ]]; then
  C_R=$'\033[31m'; C_G=$'\033[32m'; C_Y=$'\033[33m'
  C_B=$'\033[36m'; C_D=$'\033[2m';  C_0=$'\033[0m'
else
  C_R=""; C_G=""; C_Y=""; C_B=""; C_D=""; C_0=""
fi

log()  { [[ $QUIET == yes ]] && return 0; printf '%s\n' "$*"; }
info() { [[ $QUIET == yes ]] && return 0; printf '%s[*]%s %s\n' "$C_B" "$C_0" "$*"; }
ok()   { [[ $QUIET == yes ]] && return 0; printf '%s[+]%s %s\n' "$C_G" "$C_0" "$*"; }
warn() { printf '%s[!]%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
die()  { printf '%s[x]%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }

audit() {
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  printf '%s | actor=%s | %s\n' "$(date -Is)" "${SUDO_USER:-root}" "$*" \
    >>"$AUDIT_LOG" 2>/dev/null || true
}

# 破坏性操作统一走这里，受 --dry-run 控制
run() {
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s %s\n' "$C_D" "$C_0" "$*"
    return 0
  fi
  "$@"
}

require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "需要 root 运行（sudo $0 $*）"; }
need_cmd() { command -v "$1" >/dev/null 2>&1; }

ensure_dirs() {
  mkdir -p "$LIB_DIR" "$C_META_DIR" "$H_USERS_DIR" "$ARCHIVE_DIR" "$LOG_DIR" "$CONF_DIR"
  chmod 700 "$LIB_DIR" "$C_META_DIR" "$H_USERS_DIR"
  chmod 750 "$LOG_DIR"
}

# ------------------------------------------------------------------ 时长解析
# 支持：30s / 15m / 12h / 7d / 2w / 1h30m / 纯秒数
parse_duration() {
  local s="$1" total=0 num unit mult rest
  [[ -z $s ]] && die "时长不能为空"
  if [[ $s =~ ^[0-9]+$ ]]; then
    (( s > 0 )) || die "时长必须大于 0（示例：30m 12h 7d 2w 1h30m）"
    printf '%s' "$s"; return 0
  fi
  rest="$s"
  while [[ -n $rest ]]; do
    if [[ $rest =~ ^([0-9]+)([smhdw])(.*)$ ]]; then
      num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
    else
      die "非法时长格式：$s（示例：30m 12h 7d 2w 1h30m）"
    fi
    case "$unit" in
      s) mult=1 ;;
      m) mult=60 ;;
      h) mult=3600 ;;
      d) mult=86400 ;;
      w) mult=604800 ;;
    esac
    total=$(( total + num * mult ))
  done
  (( total > 0 )) || die "时长必须大于 0"
  printf '%s' "$total"
}

# 判断字符串是否时长写法（2h / 1h30m / 45）
is_duration() {
  local s="$1"
  [[ $s =~ ^([0-9]+[smhdw])+$ ]] || [[ $s =~ ^[0-9]+$ ]]
}

human_duration() {
  local s="$1" d h m
  (( s < 0 )) && { printf '已过期'; return 0; }
  d=$(( s / 86400 )); s=$(( s % 86400 ))
  h=$(( s / 3600 ));  s=$(( s % 3600 ))
  m=$(( s / 60 ))
  if   (( d > 0 )); then printf '%dd%dh' "$d" "$h"
  elif (( h > 0 )); then printf '%dh%dm' "$h" "$m"
  else                   printf '%dm' "$m"
  fi
}


# 永不过期（仅容器模式）
is_never() { [[ $1 == never || $1 == forever || $1 == permanent ]]; }

# 并发锁：create/new/extend/del/revoke 互斥
lock() { exec 9>"$LOCK_FILE"; flock -n 9 || die "另一个实例正在运行，稍后再试"; }
# ------------------------------------------------------------------ meta 读写
hu_meta_file()  { printf '%s/%s.meta' "$H_USERS_DIR" "$1"; }
hu_meta_exists(){ [[ -f "$(hu_meta_file "$1")" ]]; }
# 空文件 / 残缺文件不算「在管理中」：
# 否则 hu_meta_save 中途崩溃留下空文件后，账号会被永久卡住无法重建
hu_is_managed() {
  local f; f="$(hu_meta_file "$1")"
  [[ -s $f ]] && grep -q '^NAME=' "$f" 2>/dev/null
}

hu_meta_load() {
  local name="$1" f
  f="$(hu_meta_file "$name")"
  [[ -r $f ]] || die "账号 $name 不在管理范围内（找不到 $f）"
  # shellcheck disable=SC1090
  . "$f"
  [[ -n ${HOME_DIR:-} && -n ${WORKDIR:-} ]] \
    || die "元数据损坏或为空：$f
    若该账号已不存在，删掉这个文件即可：rm -f $f"
  # 同步进 hu_meta_save 使用的 M_* 命名空间：
  # 这样只改一个字段（如 STATUS）也能安全回写整份元数据
  M_NAME="${NAME:-$name}"
  M_CREATED="${CREATED:-0}"
  M_EXPIRES="${EXPIRES:-0}"
  M_DURATION="${DURATION:-0}"
  M_HOME="${HOME_DIR:-/home/$name}"
  M_WORKDIR="${WORKDIR:-}"
  M_RW="${RW_LIST:-}"
  M_RO="${RO_LIST:-}"
  M_PROFILE="${SUDO_PROFILE:-minimal}"
  M_SSHFROM="${SSH_FROM:-}"
  M_SHELL="${SHELL_BIN:-/bin/bash}"
  M_STATUS="${STATUS:-active}"
}

hu_meta_save() {
  local name="$1" f tmp old_umask
  f="$(hu_meta_file "$name")"
  tmp="$f.tmp.$$"
  old_umask="$(umask)"
  umask 077
  cat >"$tmp" <<EOF
NAME='${M_NAME:-$name}'
CREATED='${M_CREATED:-0}'
EXPIRES='${M_EXPIRES:-0}'
DURATION='${M_DURATION:-0}'
HOME_DIR='${M_HOME:-/home/$name}'
WORKDIR='${M_WORKDIR:-}'
RW_LIST='${M_RW:-}'
RO_LIST='${M_RO:-}'
SUDO_PROFILE='${M_PROFILE:-minimal}'
SSH_FROM='${M_SSHFROM:-}'
SHELL_BIN='${M_SHELL:-/bin/bash}'
STATUS='${M_STATUS:-active}'
EOF
  umask "$old_umask"
  chmod 600 "$tmp"
  # 原子替换：写一半崩掉也不会把原元数据截成空文件
  mv -f "$tmp" "$f"
}

user_exists() { id -u "$1" >/dev/null 2>&1; }

# 系统目录本体不得直接授权（子目录如 /etc/nginx/conf.d 允许）
SYSTEM_ROOTS=(/ /bin /boot /dev /etc /lib /lib32 /lib64 /proc /root /run /sbin /sys /usr /var)
check_grant_path() {
  local p="$1" r rp
  rp="$(readlink -m -- "$p" 2>/dev/null || printf '%s' "$p")"
  for r in "${SYSTEM_ROOTS[@]}"; do
    [[ $rp == "$r" ]] && die "拒绝把系统目录本体授权给临时账号：$rp（要授权请给具体子目录）"
  done
  [[ $rp == /home ]] && die "拒绝把 /home 整体授权（会横跨其他用户）"
  return 0
}

# ------------------------------------------------------------------- ACL 处理
apply_acl() {
  local u="$1" path="$2" mode="$3"   # mode: rw | ro
  [[ -e $path ]] || { warn "路径不存在，跳过 ACL：$path"; return 0; }
  if ! need_cmd setfacl; then
    warn "缺少 setfacl，$path 的 ACL 未设置（装包后执行 fixacl 补授权）"
    return 0
  fi
  local perm="rX"
  [[ $mode == rw ]] && perm="rwX"
  run setfacl -R -m "u:$u:$perm" "$path" \
    || warn "设置 ACL 失败：$path（$u 可能仍无法访问，装好 acl 包后跑 fixacl 补授权）"
  # 默认 ACL 只有目录能继承，对文件用 -d 会被 setfacl 拒绝
  if [[ -d $path ]]; then
    run setfacl -R -d -m "u:$u:$perm" "$path" \
      || warn "设置默认 ACL 失败：$path"
  fi
  ok "ACL $mode -> $path"
}

clear_acl() {
  local u="$1" path="$2"
  [[ -e $path ]] || return 0
  need_cmd setfacl || return 0
  run setfacl -R -x "u:$u" "$path" 2>/dev/null || true
  run setfacl -R -d -x "u:$u" "$path" 2>/dev/null || true
}

# ------------------------------------------------------------------ sudo 策略
# 生成 sudoers 片段：白名单 + 黑名单（! 取反，最后匹配生效）
gen_sudoers() {
  local u="$1" profile="$2"
  local f="/etc/sudoers.d/ailease-$u"
  local U; U="${u^^}"; U="${U//[^A-Z0-9_]/_}"     # alias 名只允许大写/数字/下划线

  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s 生成 sudo 策略 [%s] -> %s\n' "$C_D" "$C_0" "$profile" "$f"
    return 0
  fi

  if [[ $profile == none ]]; then
    run rm -f "$f"
    info "sudo-profile=none，未授予任何 sudo 权限"
    return 0
  fi

  local allow_min allow_dev allow_ops
  allow_min="/usr/bin/apt, /usr/bin/apt-get, /usr/bin/dpkg, \\
    /usr/bin/yum, /usr/bin/dnf, /usr/bin/rpm, /usr/bin/zypper, \\
    /usr/bin/systemctl, /bin/systemctl, /usr/bin/journalctl, /bin/journalctl, \\
    /usr/bin/chmod, /bin/chmod, /usr/bin/chown, /bin/chown, /usr/bin/chgrp, /bin/chgrp, \\
    /usr/bin/mkdir, /bin/mkdir, /usr/bin/cp, /bin/cp, /usr/bin/mv, /bin/mv, \\
    /usr/bin/ln, /bin/ln, /usr/bin/touch, /usr/bin/stat, \\
    /usr/bin/tar, /bin/tar, /usr/bin/gzip, /usr/bin/gunzip, /usr/bin/zip, /usr/bin/unzip, \\
    /usr/bin/rsync, /usr/bin/curl, /usr/bin/wget, /usr/bin/scp, \\
    /usr/bin/tee, /usr/bin/sed, /usr/bin/awk, /usr/bin/grep, /usr/bin/find, /usr/bin/sort, \\
    $AIRM_DEST"

  allow_dev="/usr/bin/git, /usr/bin/python3, /usr/bin/pip3, /usr/bin/python, \\
    /usr/bin/node, /usr/bin/npm, /usr/bin/pnpm, /usr/bin/yarn, \\
    /usr/bin/docker, /usr/bin/make, /usr/bin/gcc, /usr/bin/g++, /usr/bin/ld, \\
    /usr/bin/vim, /usr/bin/nano, /usr/bin/vi, /usr/bin/less, /usr/bin/file, \\
    /usr/bin/tree, /usr/bin/diff, /usr/bin/patch, /usr/bin/jq, /usr/bin/ssh, \\
    /usr/bin/systemd-run, /usr/bin/env, /usr/bin/xargs, /usr/bin/bash"

  allow_ops="/usr/bin/kill, /bin/kill, /usr/bin/pkill, /usr/bin/nice, /usr/bin/ionice, \\
    /usr/bin/systemd-analyze, /usr/sbin/service, /usr/sbin/ss, /usr/bin/netstat, \\
    /usr/sbin/ip, /usr/bin/lsof, /usr/bin/top, /usr/bin/ps, /usr/bin/free, /usr/bin/df, \\
    /usr/bin/mountpoint, /usr/bin/systemd-cgls, /usr/bin/loginctl, /usr/bin/last"

  local ALLOW="$allow_min"
  [[ $profile == dev || $profile == ops ]] && ALLOW="$ALLOW, $allow_dev"
  [[ $profile == ops ]] && ALLOW="$ALLOW, $allow_ops"

  # 高危：裸 rm / 磁盘操作 / 关机重启 / 内核模块 / 提权面
  local DENY
  DENY="/usr/bin/rm, /bin/rm, /usr/bin/unlink, /usr/bin/shred, \\
    /usr/bin/dd, /bin/dd, /usr/sbin/mkfs, /sbin/mkfs, /usr/sbin/mkfs.*, /sbin/mkfs.*, \\
    /usr/sbin/fdisk, /sbin/fdisk, /usr/sbin/parted, /sbin/parted, /usr/sbin/sfdisk, \\
    /usr/sbin/wipefs, /usr/sbin/blkdiscard, /usr/bin/fallocate, \\
    /usr/sbin/reboot, /sbin/reboot, /usr/sbin/shutdown, /sbin/shutdown, \\
    /usr/sbin/halt, /sbin/halt, /usr/sbin/poweroff, /sbin/poweroff, /usr/bin/init, /sbin/init, \\
    /usr/sbin/insmod, /usr/sbin/rmmod, /usr/sbin/modprobe, /usr/bin/kexec, \\
    /usr/bin/chroot, /usr/sbin/chroot, /usr/sbin/visudo, /usr/bin/visudo, \\
    /usr/bin/passwd, /usr/bin/chpasswd, /usr/sbin/useradd, /usr/sbin/userdel, /usr/sbin/usermod, \\
    /usr/bin/su, /bin/su, /usr/bin/mount, /bin/mount, /usr/bin/umount, /bin/umount, \\
    /usr/bin/crontab, /usr/bin/at, /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, \\
    /usr/bin/systemctl halt, /bin/systemctl reboot, /bin/systemctl poweroff, \\
    /usr/bin/chmod -R 777 /, /usr/bin/chmod -R 777 /*, /bin/chmod -R 777 /, \\
    /usr/bin/chown -R root /, /usr/bin/rm -rf /, /usr/bin/rm -rf /*"

  {
    echo "# 由 ailease $VERSION 生成于 $(date -Is) —— 请勿手改，改动请重跑 create/extend"
    echo "Defaults:$u !requiretty"
    echo "Defaults:$u env_reset"
    echo "Defaults:$u secure_path=\"/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\""
    echo "Defaults:$u logfile=\"$LOG_DIR/sudo-$u.log\""
    echo ""
    echo "Cmnd_Alias AI_DENY_${U} = $DENY"
    echo ""
    echo "Cmnd_Alias AI_ALLOW_${U} = $ALLOW"
    echo ""
    echo "# 白名单在前、黑名单在后：sudoers 以最后匹配的规则为准"
    echo "$u ALL=(root) AI_ALLOW_${U}, !AI_DENY_${U}"
  } >"$f"

  chmod 440 "$f"
  if need_cmd visudo; then
    visudo -cf "$f" >/dev/null 2>&1 || {
      rm -f "$f"
      die "sudoers 片段语法校验失败，已回滚：$f"
    }
  fi
  ok "sudo 策略 [$profile] -> $f"
}

# --------------------------------------------------------------- ailease-rm 护栏
# 独立 wrapper：路径白名单模型，只有「授权目录 + /tmp + 自家 home」可删
emit_ai_rm() {
  run mkdir -p "$(dirname "$AIRM_DEST")"
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s 写入 %s\n' "$C_D" "$C_0" "$AIRM_DEST"
    return 0
  fi
  cat >"$AIRM_DEST" <<'AIRM_EOF'
#!/usr/bin/env bash
# ailease-rm — 受控删除。由 ailease 生成，请勿手改。
# 只允许删除：自家 home、授权工作目录、/tmp、/var/tmp。
# 其余路径一律拒绝（白名单模型），并记录审计。
set -Eeuo pipefail

META_DIR="/var/lib/ailease/users"
RM_LOG="/var/log/ailease/rm.log"

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "ailease-rm: 请通过 sudo 调用" >&2; exit 1; }

ACTOR="${SUDO_USER:-}"
if [[ -z $ACTOR ]]; then
  echo "ailease-rm: 无法识别调用者（需经 sudo 调用）" >&2
  exit 1
fi

META="$META_DIR/$ACTOR.meta"
if [[ ! -r $META ]]; then
  echo "ailease-rm: $ACTOR 不是受管账号，拒绝执行" >&2
  exit 1
fi
# shellcheck disable=SC1090
. "$META"

log_rm() {
  mkdir -p "$(dirname "$RM_LOG")" 2>/dev/null || true
  printf '%s | user=%s | rc=%s | %s\n' "$(date -Is)" "$ACTOR" "$1" "$2" >>"$RM_LOG" 2>/dev/null || true
}

# 允许根：home、工作目录、显式授权的读写目录、临时区
ALLOW_ROOTS=()
[[ -n ${HOME_DIR:-} ]] && ALLOW_ROOTS+=("$HOME_DIR")
[[ -n ${WORKDIR:-}  ]] && ALLOW_ROOTS+=("$WORKDIR")
if [[ -n ${RW_LIST:-} ]]; then
  read -r -a _rw <<<"$RW_LIST"
  ALLOW_ROOTS+=("${_rw[@]}")
fi
ALLOW_ROOTS+=(/tmp /var/tmp)
# 去重：workdir 同时出现在 WORKDIR 与 RW_LIST 里
_uniq=()
for _r in "${ALLOW_ROOTS[@]}"; do
  _seen=0
  for _u in "${_uniq[@]}"; do
    [[ $_u == "$_r" ]] && { _seen=1; break; }
  done
  (( _seen )) || _uniq+=("$_r")
done
ALLOW_ROOTS=("${_uniq[@]}")
unset _uniq _r _u _seen

# 系统保护根：即使出现在参数里也直接拒
PROTECT_ROOTS=(
  / /bin /boot /dev /etc /lib /lib32 /lib64 /proc /root /run /sbin /srv /sys /usr /var
)

norm() { readlink -m -- "$1" 2>/dev/null || printf '%s' "$1"; }

TMP_ROOTS=(/tmp /var/tmp)
in_tmp() {
  local p="$1" r
  for r in "${TMP_ROOTS[@]}"; do is_under "$p" "$r" && return 0; done
  return 1
}

is_under() {  # $1=路径 $2=根  —— 相等或以 根/ 开头
  local p="$1" r="$2"
  [[ $r == / ]] && return 0
  [[ $p == "$r" || $p == "$r"/* ]]
}

verdict() {
  local p="$1" root rp
  rp="$(norm "$p")"
  # 1) 显式授权目录优先放行
  for root in "${ALLOW_ROOTS[@]}"; do
    [[ -z $root ]] && continue
    if is_under "$rp" "$root"; then
      # 但不得借授权目录跳到系统区（如 /tmp/../etc 已由 norm 展开，这里再兜一层）
      return 0
    fi
  done
  # 2) 命中系统保护根 -> 拒绝
  for root in "${PROTECT_ROOTS[@]}"; do
    if is_under "$rp" "$root"; then
      echo "deny:$rp"
      return 1
    fi
  done
  # 3) 白名单模型：未授权的一律拒绝
  echo "deny:$rp"
  return 1
}

# ---- 参数解析：分离选项与目标 ----
OPTS=(); TARGETS=(); SEEN_DD=0; NO_PRESERVE=0; DRY=0
for a in "$@"; do
  if (( SEEN_DD )); then TARGETS+=("$a"); continue; fi
  case "$a" in
    --) SEEN_DD=1 ;;
    --no-preserve-root) NO_PRESERVE=1; OPTS+=("$a") ;;
    -n|--dry-run) DRY=1 ;;
    -*) OPTS+=("$a") ;;
    *)  TARGETS+=("$a") ;;
  esac
done

(( ${#TARGETS[@]} )) || { echo "ailease-rm: 未指定目标" >&2; exit 1; }

for t in "${TARGETS[@]}"; do
  if (( NO_PRESERVE )) && { [[ $t == / ]] || [[ $t == /* && $(norm "$t") == / ]]; }; then
    echo "ailease-rm: 拒绝 --no-preserve-root 作用于根目录" >&2
    log_rm 1 "blocked-no-preserve-root $t"
    exit 1
  fi
  if ! verdict "$t" >/dev/null; then
    echo "ailease-rm: 拒绝删除未授权路径：$t" >&2
    echo "ailease-rm: 允许范围 -> ${ALLOW_ROOTS[*]}" >&2
    log_rm 1 "blocked $t"
    exit 1
  fi
  # 临时区越权保护：ailease-rm 以 root 运行，内核 sticky bit 不生效，这里补上
  rp="$(norm "$t")"
  if in_tmp "$rp" && [[ -e $rp ]]; then
    own="$(stat -c '%U' "$rp" 2>/dev/null || echo '?')"
    if [[ $own != "$ACTOR" && $own != root ]]; then
      echo "ailease-rm: 拒绝删除临时区中属于 $own 的文件：$t" >&2
      log_rm 1 "blocked-foreign-owner $t"
      exit 1
    fi
  fi
done

if (( DRY )); then
  echo "ailease-rm: [dry-run] 将删除 ${#TARGETS[@]} 个目标：${TARGETS[*]}"
  log_rm 0 "dry-run ${TARGETS[*]}"
  exit 0
fi

log_rm 0 "allow ${TARGETS[*]}"
exec /bin/rm "${OPTS[@]+"${OPTS[@]}"}" -- "${TARGETS[@]}"
AIRM_EOF
  chmod 755 "$AIRM_DEST"
  ok "护栏已安装 -> $AIRM_DEST"
}

# ------------------------------------------------------------- sshd / limits
# SSH 收敛：把 Match 块追加到 sshd_config 末尾，用标记包裹，吊销时按标记整块移除。
# 实测（Debian 12 / OpenSSH 9.2）：把 Match 放进 /etc/ssh/sshd_config.d/*.conf
# 其实也能正常工作——Match 的作用域在 Include 文件结束时就重置了，不会波及主配置
# 里 Include 之后的 Port / UsePAM / Subsystem（这两点都用 sshd -T / sshd -t 验证过）。
# 这里仍选择追加到主配置末尾，是为了不依赖该版本行为（早期 OpenSSH 与部分发行版对
# Match 作用域边界的处理不一致），代价是要直接改主配置，因此全程带 sshd -t 校验与失败回滚。
sshd_block_begin() { printf '# >>> ailease:%s >>>' "$1"; }
sshd_block_end()   { printf '# <<< ailease:%s <<<' "$1"; }

# 从 stdin 读入 sshd_config，剔除指定账号的受管块后写到 stdout
strip_sshd_block() {
  local u="$1"
  awk -v b="$(sshd_block_begin "$u")" -v e="$(sshd_block_end "$u")" '
    $0==b {skip=1; next}
    $0==e {skip=0; next}
    skip!=1 {print}
  '
}

# 去掉尾部空行，避免反复 create/revoke 在 sshd_config 里堆积空行
trim_trailing_blanks() {
  awk '{l[NR]=$0} END{n=NR; while(n>0 && l[n]=="") n--; for(i=1;i<=n;i++) print l[i]}'
}

remove_sshd_block() {
  local u="$1"
  [[ -f $SSHD_MAIN ]] || return 0
  grep -qF "$(sshd_block_begin "$u")" "$SSHD_MAIN" 2>/dev/null || return 0
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s 移除 SSH 收敛块 -> %s\n' "$C_D" "$C_0" "$SSHD_MAIN"
    return 0
  fi
  local tmp="$SSHD_MAIN.ailease.$$" cur="$SSHD_MAIN.ailease.bak.$$"
  cp -f "$SSHD_MAIN" "$cur" || return 0
  strip_sshd_block "$u" <"$cur" | trim_trailing_blanks >"$tmp"
  cp -f "$tmp" "$SSHD_MAIN"
  if need_cmd sshd && ! sshd -t 2>/dev/null; then
    cp -f "$cur" "$SSHD_MAIN"
    warn "移除 SSH 收敛块后 sshd 校验失败，已回滚"
  fi
  rm -f "$tmp" "$cur"
}

gen_sshd() {
  local u="$1"
  [[ -f $SSHD_MAIN ]] || { info "找不到 $SSHD_MAIN，跳过 SSH 收敛"; return 0; }
  # 旧版本写的 drop-in 会破坏 sshd，顺手清掉
  run rm -f "/etc/ssh/sshd_config.d/ailease-$u.conf"
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s 写入 SSH 收敛 -> %s 末尾\n' "$C_D" "$C_0" "$SSHD_MAIN"
    return 0
  fi
  # 没有 sshd 就无法校验；宁可不收敛，也不改坏主配置
  if ! need_cmd sshd; then
    warn "未找到 sshd，无法校验配置，跳过 SSH 收敛（不冒险改 $SSHD_MAIN）"
    return 0
  fi
  local tmp="$SSHD_MAIN.ailease.$$" cur="$SSHD_MAIN.ailease.bak.$$"
  cp -f "$SSHD_MAIN" "$cur" || { warn "无法读取 $SSHD_MAIN，跳过 SSH 收敛"; return 0; }
  {
    strip_sshd_block "$u" <"$cur" | trim_trailing_blanks
    printf '\n%s\n' "$(sshd_block_begin "$u")"
    printf '# 由 ailease %s 生成于 %s —— 请勿手改，改动请重跑 create/revoke\n' "$VERSION" "$(date -Is)"
    printf 'Match User %s\n' "$u"
    printf '    AllowTcpForwarding no\n'
    printf '    X11Forwarding no\n'
    printf '    PermitTunnel no\n'
    printf '    AllowAgentForwarding no\n'
    printf '    PermitEmptyPasswords no\n'
    printf '    MaxSessions 8\n'
    printf '%s\n' "$(sshd_block_end "$u")"
  } >"$tmp"
  cp -f "$tmp" "$SSHD_MAIN"
  if ! sshd -t 2>/dev/null; then
    cp -f "$cur" "$SSHD_MAIN"
    rm -f "$tmp" "$cur"
    warn "sshd 配置校验失败，已回滚 SSH 收敛（$SSHD_MAIN 未改动）"
    return 0
  fi
  rm -f "$tmp" "$cur"
  ok "SSH 收敛 -> $SSHD_MAIN 末尾（重载：systemctl reload sshd）"
}

gen_limits() {
  local u="$1"
  local f="/etc/security/limits.d/ailease-$u.conf"
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s 生成资源上限 -> %s\n' "$C_D" "$C_0" "$f"
    return 0
  fi
  [[ -d /etc/security/limits.d ]] || return 0
  cat >"$f" <<EOF
# 由 ailease 生成
$u  hard  nproc      256
$u  hard  nofile     4096
$u  hard  core       0
$u  hard  maxlogins  4
$u  soft  nproc      128
$u  soft  nofile     2048
EOF
  chmod 644 "$f"
  ok "资源上限 -> $f"
}

apply_quota() {
  local u="$1" spec="${2:-}" num mult=1 kb
  [[ -z $spec ]] && return 0
  need_cmd setquota || { warn "缺少 setquota，跳过磁盘配额"; return 0; }
  if ! quotaon -p / 2>/dev/null | grep -q 'user quota.*on'; then
    warn "根文件系统未启用 user quota，跳过配额设置（可用 XFS project quota 替代）"
    return 0
  fi
  case "$spec" in
    *[Kk]) num="${spec%[Kk]}" ;;
    *[Mm]) num="${spec%[Mm]}"; mult=1024 ;;
    *[Gg]) num="${spec%[Gg]}"; mult=1048576 ;;
    *[Tt]) num="${spec%[Tt]}"; mult=1073741824 ;;
    *) warn "配额格式无法识别：$spec（示例 20G）"; return 0 ;;
  esac
  [[ $num =~ ^[0-9]+$ ]] || { warn "配额数值非法：$spec"; return 0; }
  kb=$(( 10#$num * mult ))
  run setquota -u "$u" 0 "$kb" 0 "$(( kb * 11 / 10 ))" /
  ok "磁盘配额 -> $spec"
}

# --------------------------------------------------------------- 用户级收敛
inject_bashrc() {
  local u="$1" home="$2"
  local rc="$home/.bashrc"
  [[ $DRY_RUN == yes ]] && { printf '  %s[dry-run]%s 注入 %s\n' "$C_D" "$C_0" "$rc"; return 0; }
  touch "$rc"
  if grep -q 'AILEASE-BEGIN' "$rc" 2>/dev/null; then return 0; fi
  cat >>"$rc" <<'RC_EOF'

# >>> AILEASE-BEGIN >>>
export HISTTIMEFORMAT='%F %T '
export HISTSIZE=20000
export HISTFILESIZE=20000
umask 077
shopt -s histappend 2>/dev/null || true
# 把每条命令落进系统审计（root 可读）
export PROMPT_COMMAND='history -a; logger -t ai-audit -p authpriv.notice -- "cmd: $(history 1 | sed "s/^ *[0-9]* *//")" 2>/dev/null'
# 手滑防线：rm 一律走护栏（非安全边界，安全边界在 sudoers）
alias rm='/usr/local/sbin/ailease-rm'
alias rmdir='/usr/local/sbin/ailease-rm -d'
# >>> AILEASE-END >>>
RC_EOF
  chown "$u:$u" "$rc" 2>/dev/null || true
  chmod 600 "$rc"
}

install_pubkey() {
  local u="$1" home="$2" key="$3" from="$4"
  [[ -z $key ]] && return 0
  local line="$key"
  [[ -n $from ]] && line="from=\"$from\" $key"
  run install -d -m 700 -o "$u" -g "$u" "$home/.ssh"
  if [[ $DRY_RUN == no ]]; then
    printf '%s\n' "$line" >"$home/.ssh/authorized_keys"
    chown "$u:$u" "$home/.ssh/authorized_keys"
    chmod 600 "$home/.ssh/authorized_keys"
  fi
  ok "公钥已写入 $home/.ssh/authorized_keys${from:+ (from=$from)}"
}

# --------------------------------------------------------------------- 创建
hu_create() {
  local name="" duration="$DEFAULT_DURATION" profile="$DEFAULT_PROFILE"
  local pw="" use_stdin=0 genpw=0 force_change=0 pubkey="" pubkey_file=""
  local ssh_from="" shell="$DEFAULT_SHELL" quota="" restricted=0
  local -a rw_list=() ro_list=()
  local workdir=""

  while (( $# )); do
    case "$1" in
      -n|--name)        name="$2"; shift 2 ;;
      --duration|-t)    duration="$2"; shift 2 ;;
      --password|-p)    pw="$2"; shift 2 ;;
      --password-stdin) use_stdin=1; shift ;;
      --gen-password)   genpw=1; shift ;;
      --force-change)   force_change=1; shift ;;
      --pubkey)         pubkey="$2"; shift 2 ;;
      --pubkey-file)    pubkey_file="$2"; shift 2 ;;
      --ssh-from)       ssh_from="$2"; shift 2 ;;
      --sudo-profile)   profile="$2"; shift 2 ;;
      --rw)             rw_list+=("$2"); shift 2 ;;
      --ro)             ro_list+=("$2"); shift 2 ;;
      --workdir)        workdir="$2"; shift 2 ;;
      --quota)          quota="$2"; shift 2 ;;
      --shell)          shell="$2"; shift 2 ;;
      --restricted)     restricted=1; shift ;;
      -h|--help)        usage; exit 0 ;;
      *) die "未知参数：$1（-h 查看用法）" ;;
    esac
  done

  [[ -n $name ]] || die "必须指定 --name"
  [[ $name =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "用户名非法：只允许小写字母/数字/下划线/短横线，且以字母或下划线开头"
  user_exists "$name" && ! hu_is_managed "$name" && die "系统已存在同名用户 $name（非本工具管理，先人工处理）"
  hu_is_managed "$name" && die "$name 已在管理中，用 extend / revoke / status"

  case "$profile" in minimal|dev|ops|none) ;; *) die "--sudo-profile 只能是 minimal|dev|ops|none" ;; esac

  # 密钥来源
  if [[ -n $pubkey_file ]]; then
    [[ -r $pubkey_file ]] || die "公钥文件不可读：$pubkey_file"
    pubkey="$(head -n1 "$pubkey_file")"
  fi
  if [[ -n $pubkey ]]; then
    [[ $pubkey =~ ^(ssh-rsa|ssh-ed25519|ecdsa-sha2-nistp[0-9]+|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)[[:space:]] ]] \
      || die "公钥格式不正确（应以 ssh-ed25519 / ssh-rsa / ecdsa-... 开头）"
  fi

  # 密码来源
  if (( use_stdin )); then
    IFS= read -r pw || die "从 stdin 读取密码失败"
  fi
  if (( genpw )); then
    pw="$(tr -dc 'A-Za-z0-9@#%^_+=!' </dev/urandom | head -c 24 || true)"
  fi
  [[ -z $pubkey && -z $pw ]] && die "至少提供一种凭据：--password / --password-stdin / --gen-password / --pubkey"
  if [[ -n $pw && ${#pw} -lt 8 ]]; then
    warn "密码长度不足 8 位，仍按你要求设置"
  fi

  local secs expires created
  secs="$(parse_duration "$duration")"
  created="$(date +%s)"
  expires=$(( created + secs ))

  local home="/home/$name"
  [[ -n $workdir ]] || workdir="$DEFAULT_WORKROOT/$name"

  # 授权路径体检：挡住「把 /etc 整个交出去」这类误配
  local g
  check_grant_path "$workdir"
  for g in "${rw_list[@]+"${rw_list[@]}"}" "${ro_list[@]+"${ro_list[@]}"}"; do
    check_grant_path "$g"
  done

  info "创建 $name：时长 $(human_duration "$secs")，到期 $(date -d "@$expires" '+%F %T')"

  local shell_bin="$shell"
  (( restricted )) && shell_bin="/bin/rbash"
  [[ -x $shell_bin ]] || shell_bin="/bin/bash"

  run useradd --create-home --home-dir "$home" --shell "$shell_bin" \
      --comment "AI temp account (managed by ailease)" "$name"
  run usermod -U "$name" 2>/dev/null || true

  # 家目录收紧到 0700：useradd 默认按 UMASK 022 建 755，同机其他用户能进去读
  if [[ $DRY_RUN == no && -d $home ]]; then
    chmod 700 "$home"
  fi

  if [[ -n $pw ]]; then
    if [[ $DRY_RUN == no ]]; then
      printf '%s:%s\n' "$name" "$pw" | chpasswd
      (( force_change )) && chage -d 0 "$name"
    fi
    if (( force_change )); then
      ok "密码已设置（首次登录强制改密）"
    else
      ok "密码已设置"
    fi
  fi

  # 精确到期交给回收器；chage 取次日做粗粒度兜底，避免提前误杀
  run chage -E "$(date -d "@$(( expires + 86400 ))" +%F)" -m 0 -M 99999 -I -1 "$name"

  install_pubkey "$name" "$home" "$pubkey" "$ssh_from"

  # 工作目录：新建时由 root 持有 0700 并只对本账号开 ACL；已存在的目录一律不碰
  if [[ $DRY_RUN == no ]]; then
    if [[ ! -d $workdir ]]; then
      mkdir -p "$workdir"
      chown root:root "$workdir"
      chmod 0700 "$workdir"
    else
      info "工作目录已存在，保留其原有属主与权限：$workdir"
    fi
  fi
  apply_acl "$name" "$workdir" rw
  rw_list+=("$workdir")
  local p
  for p in "${ro_list[@]+"${ro_list[@]}"}"; do apply_acl "$name" "$p" ro; done
  for p in "${rw_list[@]+"${rw_list[@]}"}"; do
    [[ $p == "$workdir" ]] && continue
    apply_acl "$name" "$p" rw
  done

  gen_sudoers "$name" "$profile"
  gen_sshd "$name"
  gen_limits "$name"
  apply_quota "$name" "$quota"
  inject_bashrc "$name" "$home"

  M_NAME="$name"; M_CREATED="$created"; M_EXPIRES="$expires"
  M_DURATION="$secs"; M_HOME="$home"; M_WORKDIR="$workdir"
  M_RW="${rw_list[*]:-}"; M_RO="${ro_list[*]:-}"
  M_PROFILE="$profile"; M_SSHFROM="$ssh_from"; M_SHELL="$shell_bin"; M_STATUS="active"
  run hu_meta_save "$name"

  audit "create name=$name duration=${secs}s expires=$expires profile=$profile workdir=$workdir rw='${M_RW}' ro='${M_RO}'"

  echo
  ok "账号就绪"
  printf '  %s用户名%s   %s\n' "$C_D" "$C_0" "$name"
  [[ -n $pw ]] && printf '  %s密码%s     %s\n' "$C_D" "$C_0" "$pw"
  printf '  %s到期%s     %s（%s 后）\n' "$C_D" "$C_0" "$(date -d "@$expires" '+%F %T')" "$(human_duration "$secs")"
  printf '  %s工作目录%s %s\n' "$C_D" "$C_0" "$workdir"
  printf '  %s可读%s     %s\n' "$C_D" "$C_0" "${ro_list[*]:-无}"
  printf '  %ssudo%s     %s\n' "$C_D" "$C_0" "$profile"
  printf '  %s删除%s     sudo ailease-rm <路径>\n' "$C_D" "$C_0"
  echo
  [[ -n $pw ]] && warn "密码只显示这一次，请立即转交给使用者"

  if ! need_cmd setfacl; then
    echo
    warn "⚠ 本机缺少 setfacl，目录授权尚未生效：$name 现在访问不了 $workdir"
    warn "  1) 装包   apt install -y acl      （RHEL 系：dnf install -y acl）"
    warn "  2) 补授权 sudo $0 fixacl $name"
  fi
  return 0
}

# ------------------------------------------------ 极简入口：new / add / mk
# 用法：new <用户名> [目录] [时长] [sudo档位]
# 例：  new ai /clicd 2h
hu_new() {
  local -a p=("$@")
  if (( ${#p[@]} == 0 )) || [[ ${p[0]:-} == -h || ${p[0]:-} == --help ]]; then
    cat <<'EOF'
用法：new <用户名> [目录] [时长] [sudo档位]

  sudo ailease new ai /clicd 2h
      建 ai 账号 + /clicd 完全读写 + 2 小时有效 + 自动生成密码

  sudo ailease new ai /clicd 2h dev
      同上，并额外放行 git / python / docker 等开发命令

  sudo ailease new ai 2h
      不指定目录，默认给 /srv/aiwork/ai

  目录省略 -> /srv/aiwork/<用户名>
  时长省略 -> 24h（支持 30m 2h 12h 7d 2w 1h30m）
  档位省略 -> minimal（装包、改权限、删文件；不放行解释器）
             可选 dev（开发） / ops（运维） / none（无 sudo）
EOF
    return 0
  fi
  (( ${#p[@]} <= 4 )) || die "参数过多。用法：new <用户名> [目录] [时长] [档位]"

  local name="${p[0]}" dir="" dur="" profile=""
  local a
  for a in "${p[@]:1}"; do
    [[ -z $a ]] && continue
    if [[ $a == */* ]]; then                      # 含 / 的一律当目录
      [[ -n $dir ]] && die "指定了多个目录：$dir 与 $a"
      dir="$a"
    elif [[ $a == minimal || $a == dev || $a == ops || $a == none ]]; then
      profile="$a"
    elif is_duration "$a"; then                   # 2h / 90m / 45
      dur="$a"
    elif [[ -z $dir ]]; then                      # 剩下的当目录
      dir="$a"
    else
      die "参数无法识别：$a（用法：new <用户名> [目录] [时长] [档位]）"
    fi
  done
  dur="${dur:-$DEFAULT_DURATION}"
  profile="${profile:-$DEFAULT_PROFILE}"

  local -a args=(--name "$name" --duration "$dur" --gen-password --sudo-profile "$profile")

  if [[ -n $dir ]]; then
    dir="$(readlink -m -- "$dir" 2>/dev/null || printf '%s' "$dir")"
    # 不在这里建目录：交给 hu_create，让它以 root:root 0700 建好再授权。
    # 在这里 mkdir 会让 hu_create 走「已存在则保留原权限」分支，0700 加固被跳过。
    args+=(--workdir "$dir")
  fi

  hu_create "${args[@]}"
}

# ----------------------------------------------------------------- 列表/详情
hu_list() {
  local f name any=0
  printf '%-20s %-10s %-19s %-19s %-10s %s\n' NAME STATUS CREATED EXPIRES REMAIN SUDO
  printf '%s\n' "--------------------------------------------------------------------------------------------------"
  shopt -s nullglob
  for f in "$H_USERS_DIR"/*.meta; do
    any=1
    # shellcheck disable=SC1090
    ( . "$f"; printf '%-20s %-10s %-19s %-19s %-10s %s\n' \
        "$NAME" "$STATUS" \
        "$(date -d "@$CREATED" '+%F %T')" "$(date -d "@$EXPIRES" '+%F %T')" \
        "$(human_duration $(( EXPIRES - $(date +%s) )))" "$SUDO_PROFILE" )
  done
  shopt -u nullglob
  (( any )) || log "（暂无受管账号）"
}

hu_status() {
  local name="${1:-}"; [[ -n $name ]] || die "用法：status <name>"
  hu_meta_load "$name"
  local now remain
  now="$(date +%s)"; remain=$(( EXPIRES - now ))
  echo "账号      : $NAME"
  echo "状态      : $STATUS"
  echo "创建      : $(date -d "@$CREATED" '+%F %T')"
  echo "到期      : $(date -d "@$EXPIRES" '+%F %T')  （剩余 $(human_duration "$remain")）"
  echo "总时长    : $(human_duration "$DURATION")"
  echo "家目录    : $HOME_DIR"
  echo "工作目录  : $WORKDIR"
  echo "读写目录  : ${RW_LIST:-无}"
  echo "只读目录  : ${RO_LIST:-无}"
  echo "sudo 档位 : $SUDO_PROFILE"
  echo "SSH 来源  : ${SSH_FROM:-不限}"
  echo "Shell     : $SHELL_BIN"
  echo "系统状态  : $(user_exists "$NAME" && echo 存在 || echo 已删除) / $(passwd -S "$NAME" 2>/dev/null | awk '{print $2}' || echo '?')"
  echo "系统到期  : $(chage -l "$NAME" 2>/dev/null | awk -F': ' '/Account expires/{print $2}' || echo '?')"
  echo "sudo 文件 : $(ls -1 /etc/sudoers.d/ailease-"$NAME" 2>/dev/null || echo 无)"
}

# --------------------------------------------------------------------- 延长
hu_extend() {
  local name="${1:-}" dur="${2:-}"; [[ -n $name && -n $dur ]] || die "用法：extend <name> <时长>"
  hu_meta_load "$name"
  local add expires
  add="$(parse_duration "$dur")"
  expires=$(( EXPIRES + add ))
  M_EXPIRES="$expires"; M_DURATION=$(( DURATION + add ))
  [[ $STATUS == expired || $STATUS == revoked ]] && M_STATUS="active"
  run hu_meta_save "$name"
  run usermod -U "$name" 2>/dev/null || true
  run chage -E "$(date -d "@$(( expires + 86400 ))" +%F)" -m 0 -M 99999 -I -1 "$name"
  audit "extend name=$name add=${add}s new_expires=$expires"
  ok "$name 已延长 $(human_duration "$add")，新到期：$(date -d "@$expires" '+%F %T')"
}

# ------------------------------------------------------- 补授权（ACL 重放）
# 装好 acl 包后，把目录授权重新刷一遍；不带参数则处理所有受管账号
hu_fixacl() {
  local name="${1:-}"
  need_cmd setfacl || die "先装 acl 包：apt install -y acl  /  dnf install -y acl"

  if [[ -z $name ]]; then
    local f found=0
    shopt -s nullglob
    for f in "$H_USERS_DIR"/*.meta; do
      found=1
      # shellcheck disable=SC1090
      ( . "$f"; echo "$NAME" ) | while read -r one; do hu_fixacl "$one"; done
    done
    shopt -u nullglob
    (( found )) || log "（暂无受管账号）"
    return 0
  fi

  hu_meta_load "$name"
  [[ $STATUS == active ]] || warn "$name 当前状态是 $STATUS，仍按元数据补授权"

  local p
  apply_acl "$name" "$WORKDIR" rw
  for p in $RW_LIST; do
    [[ $p == "$WORKDIR" ]] && continue
    apply_acl "$name" "$p" rw
  done
  for p in $RO_LIST; do
    apply_acl "$name" "$p" ro
  done
  audit "fixacl name=$name workdir=$WORKDIR"
  ok "$name 的目录授权已刷新"
}

# --------------------------------------------------------- 停用/吊销/回收
hu_disable() {
  local name="$1" mode="${2:-expire}"   # expire | revoke
  hu_meta_load "$name"

  if [[ $KILL_ON_EXPIRE == yes ]]; then
    run pkill -KILL -u "$name" 2>/dev/null || true
    info "已切断 $name 的在线会话"
  fi

  run usermod -L "$name" 2>/dev/null || true
  run chage -E 0 "$name" 2>/dev/null || true
  if [[ $DRY_RUN == no ]]; then
    if [[ -f "$HOME_DIR/.ssh/authorized_keys" ]]; then
      cp -f "$HOME_DIR/.ssh/authorized_keys" "$H_USERS_DIR/$name.authorized_keys.bak" 2>/dev/null || true
      : >"$HOME_DIR/.ssh/authorized_keys"
    fi
  fi
  ok "账号已锁定、密钥已摘除"

  run rm -f "/etc/sudoers.d/ailease-$name"
  run rm -f "/etc/ssh/sshd_config.d/ailease-$name.conf"   # 旧版本 drop-in 残留
  remove_sshd_block "$name"
  run rm -f "/etc/security/limits.d/ailease-$name.conf"
  ok "sudo / sshd / limits 配置已移除"

  local p
  for p in $WORKDIR $RW_LIST $RO_LIST; do
    [[ -n $p ]] && clear_acl "$name" "$p"
  done
  ok "ACL 授权已回收"
}

hu_archive() {
  local name="$1" home="$2" ts out
  [[ -d $home ]] || return 0
  ts="$(date +%Y%m%d-%H%M%S)"
  out="$ARCHIVE_DIR/$name-$ts.tar.gz"
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s tar 归档 %s -> %s\n' "$C_D" "$C_0" "$home" "$out"
    return 0
  fi
  tar -czf "$out" -C "$(dirname "$home")" "$(basename "$home")" 2>/dev/null || warn "归档失败：$home"
  chmod 600 "$out"
  ok "家目录已归档 -> $out"
}

hu_revoke() {
  local name="${1:-}"; shift || true
  local purge=0 keep_home=0
  while (( $# )); do
    case "$1" in
      --purge) purge=1; shift ;;
      --keep-home) keep_home=1; shift ;;
      *) die "未知参数：$1" ;;
    esac
  done
  [[ -n $name ]] || die "用法：revoke <name> [--purge]"
  hu_meta_load "$name"

  hu_disable "$name" revoke

  if (( purge )); then
    if (( keep_home == 0 )); then hu_archive "$name" "$HOME_DIR"; fi
    run userdel -r "$name" 2>/dev/null || run userdel "$name" 2>/dev/null || true
    ok "账号 $name 已删除"
    M_STATUS="purged"
  else
    M_STATUS="revoked"
    info "保留家目录 $HOME_DIR（--purge 可一并删除）"
  fi
  run hu_meta_save "$name"
  audit "revoke name=$name purge=$purge"
}

# ---------------------------------------------------------------- 删除账号
# del <用户名> [-y] —— 一步到位：吊销 + 归档家目录 + 删除账号
hu_del() {
  local name="${1:-}" force=0 keep_home=0
  shift || true
  while (( $# )); do
    case "$1" in
      -y|--yes)    force=1; shift ;;
      --keep-home) keep_home=1; shift ;;
      *) die "未知参数：$1（用法：del <用户名> [-y] [--keep-home]）" ;;
    esac
  done
  [[ -n $name ]] || die "用法：del <用户名> [-y] [--keep-home]"

  hu_meta_load "$name"

  if (( force == 0 )); then
    if [[ -t 0 ]]; then
      printf '将删除账号 %s 及其家目录 %s（家目录会先归档到 %s）。确认？[y/N] ' \
        "$name" "$HOME_DIR" "$ARCHIVE_DIR"
      local ans=""
      read -r ans || true
      case "$ans" in
        y|Y|yes|YES) ;;
        *) info "已取消，账号保持原样"; return 0 ;;
      esac
    else
      die "非交互环境需显式确认：del $name -y"
    fi
  fi

  local -a extra=(--purge)
  (( keep_home )) && extra+=(--keep-home)
  hu_revoke "$name" "${extra[@]}"
  ok "$name 已删除（家目录归档在 $ARCHIVE_DIR）"
}

hu_cleanup() {
  local f name now
  now="$(date +%s)"
  shopt -s nullglob
  for f in "$H_USERS_DIR"/*.meta; do
    # shellcheck disable=SC1090
    ( . "$f"; echo "$NAME $EXPIRES $STATUS" ) | while read -r name exp st; do
      [[ $st == active ]] || continue
      (( exp <= now )) || continue
      echo "expired $name"
    done
  done | while read -r _ name; do
    info "处理到期账号：$name"
    hu_meta_load "$name"
    hu_disable "$name" expire
    if [[ $PURGE_ON_EXPIRE == yes ]]; then
      hu_archive "$name" "$HOME_DIR"
      run userdel -r "$name" 2>/dev/null || run userdel "$name" 2>/dev/null || true
      M_STATUS="purged"
    else
      M_STATUS="expired"
    fi
    run hu_meta_save "$name"
    audit "expire name=$name purge=$PURGE_ON_EXPIRE"
    ok "$name 已到期停用"
  done
  shopt -u nullglob
  return 0
}

detect_public_ip() {
  need_cmd curl || return 1
  local svc ip
  for svc in "https://api.ipify.org" "https://ifconfig.me/ip" "https://icanhazip.com" "https://ipv4.icanhazip.com"; do
    ip="$(curl -fsS -m 5 "$svc" 2>/dev/null | tr -d '[:space:]')" || continue
    [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && { printf '%s' "$ip"; return 0; }
  done
  return 1
}

# 取本脚本的真实路径；管道执行（wget … | bash）时 $0 是 bash，这里返回失败
self_path() {
  local p="$0"
  [[ -n $p && -f $p && -r $p ]] || return 1
  head -n1 "$p" 2>/dev/null | grep -q '^#!' || return 1
  readlink -f "$p" 2>/dev/null || printf '%s' "$p"
}

docker_ok() {
  need_cmd docker || return 1
  docker info >/dev/null 2>&1 || return 1
  return 0
}

require_docker() {
  need_cmd docker || die "未安装 docker（apt install -y docker.io 或见官方文档）"
  docker info >/dev/null 2>&1 || die "连不上 docker 守护进程（服务没起？当前用户在 docker 组里吗？）"
}
# ------------------------------------------------------------------ meta 读写
dc_meta_file()   { printf '%s/%s.meta' "$C_META_DIR" "$1"; }
container_of(){ printf '%s%s' "$NAME_PREFIX" "$1"; }

dc_is_managed() {
  local f; f="$(dc_meta_file "$1")"
  [[ -s $f ]] && grep -q '^C_NAME=' "$f" 2>/dev/null
}

dc_meta_load() {
  local name="$1" f
  f="$(dc_meta_file "$name")"
  [[ -r $f ]] || die "容器 $name 不在管理范围内（找不到 $f）"
  # shellcheck disable=SC1090
  . "$f"
  [[ -n ${C_NAME:-} && -n ${C_CONTAINER:-} ]] \
    || die "元数据损坏或为空：$f
    若该容器已不存在，删掉这个文件即可：rm -f $f"
  # 同步进 dc_meta_save 使用的 M_* 命名空间
  M_NAME="${C_NAME:-$name}"
  M_CONTAINER="${C_CONTAINER:-}"
  M_IMAGE="${C_IMAGE:-$DEFAULT_IMAGE}"
  M_DIR="${C_DIR:-}"
  M_MODE="${C_MODE:-rw}"
  M_PORT="${C_PORT:-}"
  M_BIND="${C_BIND:-$DEFAULT_BIND}"
  M_CREATED="${C_CREATED:-0}"
  M_EXPIRES="${C_EXPIRES:-0}"
  M_DURATION="${C_DURATION:-0}"
  M_MEM="${C_MEM:-$DEFAULT_MEM}"
  M_CPUS="${C_CPUS:-$DEFAULT_CPUS}"
  M_PIDS="${C_PIDS:-$DEFAULT_PIDS}"
  M_USER="${C_USER:-}"
  M_STATUS="${C_STATUS:-active}"
}

dc_meta_save() {
  local name="$1" f tmp old_umask
  f="$(dc_meta_file "$name")"
  tmp="$f.tmp.$$"
  old_umask="$(umask)"
  umask 077
  cat >"$tmp" <<EOF
C_NAME='${M_NAME:-$name}'
C_CONTAINER='${M_CONTAINER:-}'
C_IMAGE='${M_IMAGE:-}'
C_DIR='${M_DIR:-}'
C_MODE='${M_MODE:-rw}'
C_PORT='${M_PORT:-}'
C_BIND='${M_BIND:-}'
C_CREATED='${M_CREATED:-0}'
C_EXPIRES='${M_EXPIRES:-0}'
C_DURATION='${M_DURATION:-0}'
C_MEM='${M_MEM:-}'
C_CPUS='${M_CPUS:-}'
C_PIDS='${M_PIDS:-}'
C_USER='${M_USER:-}'
C_STATUS='${M_STATUS:-active}'
EOF
  umask "$old_umask"
  chmod 600 "$tmp"
  # 原子替换：写一半崩掉也不会把原元数据截成空文件
  mv -f "$tmp" "$f"
}

container_exists() { docker inspect "$1" >/dev/null 2>&1; }
container_state()  { docker inspect -f '{{.State.Status}}' "$1" 2>/dev/null || echo "missing"; }

# -------------------------------------------------------- 危险挂载 / 选项体检
# 挡掉「把宿主机交出去」的写法
FORBIDDEN_MOUNTS=(/ /etc /root /home /usr /var /bin /sbin /lib /lib64 /boot /dev /proc /sys /run)

check_mount_path() {
  local p="$1" r rp
  rp="$(readlink -m -- "$p" 2>/dev/null || printf '%s' "$p")"
  [[ $rp == /* ]] || die "挂载路径必须是绝对路径：$p"
  for r in "${FORBIDDEN_MOUNTS[@]}"; do
    [[ $rp == "$r" ]] && die "拒绝挂载系统目录本体：$rp（要挂请给具体子目录）"
  done
  [[ $rp == /var/run/docker.sock || $rp == /run/docker.sock ]] \
    && die "拒绝挂载 docker.sock —— 这等于把宿主机 root 交给容器"
  return 0
}

# ---------------------------------------------------------------- 基础镜像
# 构建过程的内存上限：取宿主机可用内存的 3/4，避免在小机器上触发 OOM
# 把别的服务（数据库、媒体服务器…）一起带走
build_mem_cap() {
  local avail v
  avail="$(awk '/^MemAvailable:/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)"
  if (( avail <= 0 )); then printf '1g'; return 0; fi
  v=$(( avail * 3 / 4 ))
  (( v < 128 )) && v=128
  (( v > 2048 )) && v=2048
  printf '%dm' "$v"
}

build_base_image() {
  local img="$1" cap
  if docker image inspect "$img" >/dev/null 2>&1; then
    info "基础镜像已存在：$img"
    return 0
  fi
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s docker pull %s（拉不到则本地构建）\n' "$C_D" "$C_0" "$img"
    return 0
  fi
  # 优先从 registry 拉：镜像推到 Docker Hub 后，各机器就不必本地构建
  local pull_err
  if pull_err="$(docker pull "$img" 2>&1)"; then
    ok "已从 registry 拉取：$img"
    return 0
  fi
  warn "拉取 $img 失败，原因如下："
  printf '%s\n' "$pull_err" | tail -n 4 | sed 's/^/    /'
  cap="$(build_mem_cap)"
  info "改为本地构建（内存上限 $cap，约 1-3 分钟）"
  # 当前目录有 Dockerfile 就用它（方便自定义镜像），否则用内置的那份
  if [[ -r ./Dockerfile ]]; then
    info "使用当前目录的 Dockerfile"
    docker build --memory="$cap" -t "$img" -f ./Dockerfile . || die "基础镜像构建失败"
  else
    docker build --memory="$cap" -t "$img" - <<'DOCKERFILE' || die "基础镜像构建失败"
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-server ca-certificates curl wget git vim-tiny less file \
      python3 python3-pip python3-venv jq unzip zip tar rsync procps iproute2 \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /run/sshd /root/.ssh /etc/ssh/sshd_config.d \
 && chmod 700 /root/.ssh \
 && ssh-keygen -A \
 && printf 'PermitRootLogin yes\nPasswordAuthentication yes\nUsePAM no\n' \
      > /etc/ssh/sshd_config.d/99-ailease.conf
WORKDIR /work
EXPOSE 22
CMD ["/usr/sbin/sshd","-D","-e"]
DOCKERFILE
  fi
  ok "基础镜像就绪：$img"
}

# ------------------------------------------------------------------ 起容器
dc_new() {
  local -a p=("$@")
  if (( ${#p[@]} == 0 )) || [[ ${p[0]:-} == -h || ${p[0]:-} == --help ]]; then
    dc_usage_new
    return 0
  fi

  local name="${p[0]}"
  local dir="" dur="" image="" mode="rw" bind="$DEFAULT_BIND" host_port=""
  local mem="$DEFAULT_MEM" cpus="$DEFAULT_CPUS" pids="$DEFAULT_PIDS"
  local pw="" pubkey="" run_user="" readonly=0 pubkey_file=""

  local -a rest=("${p[@]:1}")
  local a
  for a in "${rest[@]}"; do
    [[ -z $a ]] && continue
    case "$a" in
      --ro)          mode="ro" ;;
      --rw)          mode="rw" ;;
      --public)      bind="0.0.0.0" ;;
      --bind=*)      bind="${a#--bind=}" ;;
      --port=*)      host_port="${a#--port=}"
                     [[ $host_port =~ ^[0-9]+$ ]] || die "--port 必须是数字，例如 --port=2000" ;;
      --readonly)    readonly=1 ;;
      --password=*)  pw="${a#--password=}" ;;
      --pubkey=*)    pubkey="${a#--pubkey=}" ;;
      --pubkey-file=*) pubkey_file="${a#--pubkey-file=}" ;;
      --user=*)      run_user="${a#--user=}" ;;
      --image=*)     image="${a#--image=}" ;;
      --mem=*)       mem="${a#--mem=}" ;;
      --cpus=*)      cpus="${a#--cpus=}" ;;
      --pids=*)      pids="${a#--pids=}" ;;
      --*)           die "未知选项：$a（-h 查看用法）" ;;
      *)
        if [[ $a == */* ]]; then
          [[ -n $dir ]] && die "指定了多个目录：$dir 与 $a"
          dir="$a"
        elif [[ $a == minimal || $a == dev || $a == ops || $a == none ]]; then
          # 与 --host 模式的参数对齐：容器内本来就是 root，档位无意义，忽略
          info "容器模式忽略 sudo 档位「$a」（容器内是 root）"
        elif is_never "$a" || is_duration "$a"; then
          dur="$a"
        elif [[ -z $dir ]]; then
          dir="$a"
        else
          die "参数无法识别：$a（用法：new <名字> [目录] [时长] [选项]）"
        fi
        ;;
    esac
  done

  [[ $name =~ ^[a-z0-9][a-z0-9_-]{0,30}$ ]] \
    || die "名字非法：只允许小写字母/数字/下划线/短横线，≤31 字符"
  dc_is_managed "$name" && die "$name 已在管理中，用 extend / del / status"

  dur="${dur:-$DEFAULT_DURATION}"
  image="${image:-$DEFAULT_IMAGE}"
  local secs created expires never=0
  secs="$(parse_duration "$dur")"
  created="$(date +%s)"
  if (( secs == 0 )); then
    never=1
    expires=0
  else
    expires=$(( created + secs ))
  fi

  # 目录：不指定就建一个专属空目录
  if [[ -z $dir ]]; then
    dir="$LIB_DIR/work/$name"
    info "未指定目录，使用专属目录：$dir"
  fi
  dir="$(readlink -m -- "$dir" 2>/dev/null || printf '%s' "$dir")"
  check_mount_path "$dir"
  if [[ ! -d $dir ]]; then
    info "目录不存在，先建出来：$dir"
    run mkdir -p "$dir"
  fi

  # 凭据
  if [[ -n $pubkey_file ]]; then
    [[ -r $pubkey_file ]] || die "公钥文件不可读：$pubkey_file"
    pubkey="$(head -n1 "$pubkey_file")"
  fi
  if [[ -n $pubkey ]]; then
    [[ $pubkey =~ ^(ssh-rsa|ssh-ed25519|ecdsa-sha2-nistp[0-9]+|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)[[:space:]] ]] \
      || die "公钥格式不正确（应以 ssh-ed25519 / ssh-rsa / ecdsa-... 开头）"
  fi
  if [[ -z $pubkey && -z $pw ]]; then
    pw="$(tr -dc 'A-Za-z0-9@#%^_+=!' </dev/urandom | head -c 24 || true)"
  fi

  local cname; cname="$(container_of "$name")"
  if container_exists "$cname"; then
    die "docker 里已存在同名容器 $cname（非本工具管理？先 docker rm -f $cname）"
  fi

  # 基础镜像必须先就位，否则 docker run 只会吐一句 Unable to find image
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    if [[ $DRY_RUN == yes ]]; then
      warn "本机没有镜像 $image，真跑之前要先 install 或 import"
    elif pull_err="$(docker pull "$image" 2>&1)"; then
      ok "已从 registry 拉取镜像：$image"
    else
      warn "拉取 $image 失败，原因如下："
      printf '%s\n' "$pull_err" | tail -n 4 | sed 's/^/    /'
      die "本机没有镜像 $image

  两条路，任选其一：
    1) 本机构建（需要外网，约 1-3 分钟）
         sudo $0 install
    2) 从已经装好的机器上导入（离线，小内存机器推荐）
         在那边：  sudo $0 export /tmp/aidocker-base.tar.gz
         拷过来：  scp 那边:/tmp/aidocker-base.tar.gz .
         在本机：  sudo $0 import aidocker-base.tar.gz"
    fi
  fi

  # 组装 docker run
  local -a args=(run -d --name "$cname" --hostname "$name")
  args+=(--memory "$mem" --cpus "$cpus" --pids-limit "$pids")
  args+=(--security-opt no-new-privileges)
  args+=(--cap-drop=SYS_ADMIN --cap-drop=SYS_MODULE --cap-drop=SYS_PTRACE)
  args+=(--cap-drop=SYS_RAWIO --cap-drop=MKNOD --cap-drop=AUDIT_WRITE)
  args+=(--restart no)
  args+=(--ulimit nofile=4096:4096)
  args+=(-e "TZ=${TZ:-Asia/Shanghai}")
  [[ -n $run_user ]] && args+=(--user "$run_user")
  (( readonly )) && args+=(--read-only --tmpfs /tmp:rw,size=512m --tmpfs /run:rw,size=64m)
  args+=(-v "$dir:/work${mode:+:$mode}")
  args+=(-w /work)
  args+=(-p "${bind}:${host_port}:22")
  args+=("$image")

  local dur_text; dur_text="$(human_duration "$secs")"
  (( never )) && dur_text="永不过期"
  info "起容器 $cname：镜像 $image，目录 $dir ($mode)，时长 $dur_text"
  if [[ $DRY_RUN == yes ]]; then
    run docker "${args[@]}"
  else
    docker "${args[@]}" >/dev/null   # 容器 ID 不回显，需要时用 status/exec
  fi

  if [[ $DRY_RUN == no ]]; then
    # 等 sshd 起来
    local i
    for i in $(seq 1 40); do
      docker exec "$cname" true >/dev/null 2>&1 && break
      sleep 0.5
    done

    if [[ -n $pw ]]; then
      printf 'root:%s\n' "$pw" | docker exec -i "$cname" chpasswd >/dev/null 2>&1 \
        || warn "设置容器内 root 密码失败（容器可能没起来）"
    fi
    if [[ -n $pubkey ]]; then
      docker exec "$cname" sh -c 'mkdir -p /root/.ssh && chmod 700 /root/.ssh' >/dev/null 2>&1 || true
      # 公钥经 stdin 写入：拼进 sh -c 字符串时，密钥注释里的引号会破坏命令
      printf '%s\n' "$pubkey" \
        | docker exec -i "$cname" sh -c 'cat > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys' \
        >/dev/null 2>&1 || warn "写入容器内公钥失败"
    fi
  fi

  local port=""
  if [[ $DRY_RUN == no ]]; then
    port="$(docker port "$cname" 22/tcp 2>/dev/null | head -n1 | sed 's/.*://')"
  fi

  M_NAME="$name"; M_CONTAINER="$cname"; M_IMAGE="$image"
  M_DIR="$dir"; M_MODE="$mode"; M_PORT="$port"; M_BIND="$bind"
  M_CREATED="$created"; M_EXPIRES="$expires"; M_DURATION="$secs"
  M_MEM="$mem"; M_CPUS="$cpus"; M_PIDS="$pids"; M_USER="$run_user"
  M_STATUS="active"
  run dc_meta_save "$name"

  audit "new name=$name container=$cname dir=$dir mode=$mode expires=$expires port=$port image=$image"

  # 绑 0.0.0.0 时自动探测公网 IP，省得手工替换
  local login_host="$bind"
  if [[ $bind == "0.0.0.0" ]]; then
    login_host="$(detect_public_ip || printf '<公网IP探测失败，请手动填>')"
  fi

  echo
  ok "容器就绪"
  if [[ -n $port ]]; then
    printf '  %s登录%s     ssh -p %s root@%s\n' "$C_B" "$C_0" "$port" "$login_host"
  fi
  [[ -n $pw ]] && printf '  %s密码%s     %s\n' "$C_D" "$C_0" "$pw"
  printf '  %s路径%s     %s -> /work (%s)\n' "$C_D" "$C_0" "$dir" "$mode"
  if (( never )); then
    printf '  %s到期%s     永不过期\n' "$C_D" "$C_0"
  else
    printf '  %s到期%s     %s（%s 后）\n' "$C_D" "$C_0" "$(date -d "@$expires" '+%F %T')" "$(human_duration "$secs")"
  fi
  printf '  %s资源%s     mem=%s cpus=%s pids=%s\n' "$C_D" "$C_0" "$mem" "$cpus" "$pids"
  printf '  %s归属%s     容器内 root 写出的文件，在宿主机上属主是 root（要归你可加 --user=%s:%s）\n' \
    "$C_D" "$C_0" "$(id -u)" "$(id -g)"
  echo
  printf '  %s进容器%s   sudo ailease exec %s\n' "$C_B" "$C_0" "$name"
  echo
  if [[ $bind != "127.0.0.1" && $bind != "localhost" ]]; then
    warn "端口已开放到 $bind —— 任何能访问该地址的人都能尝试 SSH 登录"
    if [[ -z $pubkey ]]; then
      warn "  当前仅密码认证；公网暴露强烈建议改用 --pubkey='ssh-ed25519 AAAA...'"
    fi
    if [[ -n $port ]]; then
      warn "  建议用防火墙限制来源：ufw allow from <你的IP> to any port $port proto tcp"
    fi
  fi
  [[ -n $pw ]] && warn "密码只显示这一次，请立即转交给使用者"
  if (( never )); then
    warn "永不过期：这个容器不会被自动停用，用完记得手动 del"
  fi
  return 0
}

# ------------------------------------------------------------------ 列表详情
dc_list() {
  local f any=0
  printf '%-14s %-10s %-19s %-19s %-10s %-8s %s\n' NAME STATUS CREATED EXPIRES REMAIN PORT MOUNT
  printf '%s\n' "---------------------------------------------------------------------------------------------------------"
  shopt -s nullglob
  for f in "$C_META_DIR"/*.meta; do
    any=1
    # shellcheck disable=SC1090
    ( . "$f"
      if (( ${C_EXPIRES:-0} == 0 )); then
        exp="永不过期"; rem="never"
      else
        exp="$(date -d "@$C_EXPIRES" '+%F %T')"
        rem="$(human_duration $(( C_EXPIRES - $(date +%s) )))"
      fi
      printf '%-14s %-10s %-19s %-19s %-10s %-8s %s\n' \
        "$C_NAME" "$C_STATUS" \
        "$(date -d "@$C_CREATED" '+%F %T')" "$exp" "$rem" "${C_PORT:-?}" "$C_DIR" )
  done
  shopt -u nullglob
  (( any )) || log "（暂无受管容器）"
}

dc_status() {
  local name="${1:-}"; [[ -n $name ]] || die "用法：status <名字>"
  dc_meta_load "$name"
  local now remain state
  now="$(date +%s)"; remain=$(( M_EXPIRES - now ))
  state="$(container_state "$M_CONTAINER")"
  echo "名字      : $M_NAME"
  echo "容器名    : $M_CONTAINER"
  echo "状态      : $M_STATUS（docker: $state）"
  echo "镜像      : $M_IMAGE"
  echo "挂载      : $M_DIR -> /work ($M_MODE)"
  echo "创建      : $(date -d "@$M_CREATED" '+%F %T')"
  if (( M_EXPIRES == 0 )); then
    echo "到期      : 永不过期（回收器会跳过这个容器）"
  else
    echo "到期      : $(date -d "@$M_EXPIRES" '+%F %T')  （剩余 $(human_duration "$remain")）"
  fi
  echo "总时长    : $(human_duration "$M_DURATION")"
  echo "资源      : mem=$M_MEM cpus=$M_CPUS pids=$M_PIDS"
  echo "端口      : ${M_PORT:-?}（绑定 $M_BIND）"
  echo "运行用户  : ${M_USER:-root（容器内）}"
  if [[ $state != missing ]]; then
    echo "IP        : $(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$M_CONTAINER" 2>/dev/null || echo '?')"
    echo "启动时间  : $(docker inspect -f '{{.State.StartedAt}}' "$M_CONTAINER" 2>/dev/null || echo '?')"
  fi
}

dc_exec() {
  local name="${1:-}"; shift || true
  [[ -n $name ]] || die "用法：exec <名字> [命令...]"
  dc_meta_load "$name"
  local cname="$M_CONTAINER"
  container_exists "$cname" || die "容器 $cname 不存在"
  if (( $# )); then
    exec docker exec -i "$cname" "$@"
  else
    exec docker exec -it "$cname" bash -l
  fi
}

# --------------------------------------------------------------------- 延长
dc_extend() {
  local name="${1:-}" dur="${2:-}"
  [[ -n $name && -n $dur ]] || die "用法：extend <名字> <时长>"
  dc_meta_load "$name"
  if (( M_EXPIRES == 0 )); then
    info "$name 当前是永不过期，无需延长"
    return 0
  fi
  local add expires
  add="$(parse_duration "$dur")"
  (( add > 0 )) || die "extend 不接受 never（这个容器本来就有到期时间，要延长请给具体时长）"
  expires=$(( M_EXPIRES + add ))
  M_EXPIRES="$expires"
  M_DURATION=$(( M_DURATION + add ))
  [[ $M_STATUS == expired ]] && M_STATUS="active"
  run dc_meta_save "$name"
  if [[ $M_STATUS == active && $DRY_RUN == no ]] && container_exists "$M_CONTAINER"; then
    docker start "$M_CONTAINER" >/dev/null 2>&1 || true
  fi
  audit "extend name=$name add=${add}s new_expires=$expires"
  ok "$name 已延长 $(human_duration "$add")，新到期：$(date -d "@$expires" '+%F %T')"
}

# --------------------------------------------------------- 停用 / 删除 / 回收
stop_container() {
  local cname="$1" mode="${2:-expire}"
  container_exists "$cname" || { info "容器 $cname 已不存在"; return 0; }
  run docker stop -t 10 "$cname" >/dev/null 2>&1 || true
  ok "容器已停止：$cname"
}

dc_del() {
  local name="${1:-}" force=0
  shift || true
  while (( $# )); do
    case "$1" in
      -y|--yes) force=1; shift ;;
      *) die "未知参数：$1（用法：del <名字> [-y]）" ;;
    esac
  done
  [[ -n $name ]] || die "用法：del <名字> [-y]"
  dc_meta_load "$name"

  if (( force == 0 )); then
    if [[ -t 0 ]]; then
      printf '将停止并删除容器 %s。挂载目录 %s 会原样保留（脚本不碰宿主机文件）。确认？[y/N] ' \
        "$M_CONTAINER" "$M_DIR"
      local ans=""
      read -r ans || true
      case "$ans" in
        y|Y|yes|YES) ;;
        *) info "已取消，容器保持原样"; return 0 ;;
      esac
    else
      die "非交互环境需显式确认：del $name -y"
    fi
  fi

  if container_exists "$M_CONTAINER"; then
    run docker rm -f "$M_CONTAINER" >/dev/null 2>&1 || true
    ok "容器已删除：$M_CONTAINER"
  else
    info "容器 $M_CONTAINER 已不存在"
  fi
  # 元数据一并删掉：容器都没了，留着只会挡住同名重建
  run rm -f "$(dc_meta_file "$name")"
  audit "del name=$name container=$M_CONTAINER"
  ok "$name 已清理，元数据已删除（挂载目录 $M_DIR 未改动）"
}

dc_cleanup() {
  local f name now
  now="$(date +%s)"
  shopt -s nullglob
  for f in "$C_META_DIR"/*.meta; do
    ( . "$f" 2>/dev/null
      [[ ${C_STATUS:-} == active ]] || exit 0
      [[ -n ${C_EXPIRES:-} ]] || exit 0
      (( ${C_EXPIRES:-0} > 0 )) || exit 0      # 0 = 永不过期，回收器不碰
      (( C_EXPIRES <= $(date +%s) )) || exit 0
      echo "${C_NAME:-}" ) | while read -r name; do
        [[ -n $name ]] || continue
        info "处理到期容器：$name"
        dc_meta_load "$name"
        stop_container "$M_CONTAINER" expire
        if [[ $PURGE_ON_EXPIRE == yes ]]; then
          container_exists "$M_CONTAINER" && run docker rm -f "$M_CONTAINER" >/dev/null 2>&1 || true
          M_STATUS="removed"
        else
          M_STATUS="expired"
        fi
        run dc_meta_save "$name"
        audit "expire name=$name purge=$PURGE_ON_EXPIRE"
        ok "$name 已到期停用"
      done
  done
  shopt -u nullglob
  return 0
}

# ------------------------------------------------------------ 镜像离线分发
# 小内存机器不适合本地构建，从已装好的机器导出再导入更省事
dc_export() {
  local out="${1:-./aidocker-base.tar.gz}"
  require_docker
  docker image inspect "$DEFAULT_IMAGE" >/dev/null 2>&1 \
    || die "本机没有 $DEFAULT_IMAGE，先跑 install 构建出来"
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s docker save %s | gzip > %s\n' "$C_D" "$C_0" "$DEFAULT_IMAGE" "$out"
    return 0
  fi
  info "导出 $DEFAULT_IMAGE -> $out（约 380MB，压缩需要一两分钟）"
  docker save "$DEFAULT_IMAGE" | gzip -1 > "$out" || die "导出失败"
  ok "导出完成：$out（$(du -h "$out" 2>/dev/null | cut -f1)）"
  echo "  拷到目标机器后执行：sudo $SELF_DEST import $out"
}

dc_import() {
  local f="${1:-}"
  [[ -n $f ]] || die "用法：import <镜像文件.tar.gz>"
  [[ -r $f ]] || die "文件不可读：$f"
  require_docker
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s gunzip -c %s | docker load\n' "$C_D" "$C_0" "$f"
    return 0
  fi
  info "导入镜像（约需 1-2 分钟）"
  gunzip -c "$f" | docker load || die "导入失败，文件可能不完整"
  docker images "$DEFAULT_IMAGE" --format '  {{.Repository}}:{{.Tag}}  {{.Size}}'
  ok "导入完成，现在可以 new 了"
}

dc_usage_new() {
  cat <<EOF
用法：new <名字> [目录] [时长] [选项]

  sudo ailease new ai /clicd 2h
      起一个容器，把 /clicd 挂到容器内 /work，容器内 root，2 小时后自动停

  sudo ailease new ai /clicd never
      同上，但永不过期（不会被自动停用，用完要手动 del）

  sudo ailease new ai /clicd 2h --public
      端口绑到 0.0.0.0（默认只绑 127.0.0.1，只有本机能连）

  位置参数（顺序随意）
    名字     容器标识，小写字母/数字/_/-，≤31 字符        必填
    目录     挂进容器 /work 的宿主目录                     省略 -> /var/lib/ailease/work/<名字>
    时长     30m 2h 12h 7d                                省略 -> 24h
             never / forever / permanent = 永不过期（不会被自动停用）

  选项
    --ro              目录只读挂载（容器内改不了）
    --public          端口绑 0.0.0.0（默认 127.0.0.1）
    --readonly        容器根文件系统只读，只留 /tmp /run 可写
    --password=xxx    指定容器内 root 密码（默认自动生成）
    --pubkey='ssh-ed25519 AAAA...'   用公钥登录
    --pubkey-file=PATH               从文件读公钥（取首行）
    --user=uid:gid    以该 uid/gid 运行（挂载目录里写出的文件归它）
    --image=xxx       换镜像（默认 $BUILTIN_IMAGE）
    --mem=2g --cpus=2 --pids=512     资源上限

  容器内默认：root 用户，工作目录 /work，开放 sshd（22）
EOF
}

# =============================================================================
#  安装 / 卸载 / 自检
# =============================================================================

# 尝试自动安装 docker；失败不致命，--host 模式不依赖 docker
install_docker() {
  if docker_ok; then
    info "docker 已就绪：$(docker --version 2>/dev/null)"
    return 0
  fi
  if need_cmd docker; then
    warn "docker 已安装但守护进程连不上，尝试启动"
    if need_cmd systemctl; then
      run systemctl enable --now docker 2>/dev/null || true
      docker_ok && { ok "docker 守护进程已启动"; return 0; }
    fi
    warn "docker 守护进程仍不可用"
    return 1
  fi

  info "未检测到 docker，尝试自动安装"
  local installed=1
  if need_cmd apt-get; then
    run apt-get update -qq || true
    run env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends docker.io || installed=0
  elif need_cmd dnf; then
    run dnf install -y docker || installed=0
  elif need_cmd yum; then
    run yum install -y docker || installed=0
  elif need_cmd zypper; then
    run zypper --non-interactive install docker || installed=0
  elif need_cmd apk; then
    run apk add --no-cache docker || installed=0
  else
    warn "未识别的包管理器，无法自动安装 docker"
    installed=0
  fi
  if (( installed == 0 )); then
    warn "自动安装 docker 失败。手工装好后再跑 install，或直接用 --host 模式"
    return 1
  fi
  if need_cmd systemctl; then run systemctl enable --now docker 2>/dev/null || true; fi
  if docker_ok; then ok "docker 安装完成：$(docker --version 2>/dev/null)"; return 0; fi
  warn "docker 已安装但守护进程连不上（服务没起？）"
  return 1
}

# 一个回收器同时管容器与账号：都调 ailease cleanup
install_reaper() {
  run mkdir -p "$(dirname "$REAPER_CRON")"

  if need_cmd systemctl && [[ -d /run/systemd/system ]]; then
    if [[ $DRY_RUN == no ]]; then
      cat >"$REAPER_SVC" <<EOF
[Unit]
Description=ailease expiry reaper (containers + host accounts)
After=network.target

[Service]
Type=oneshot
ExecStart=$SELF_DEST cleanup --quiet
Nice=10
IOSchedulingClass=idle
EOF
      cat >"$REAPER_TIMER" <<EOF
[Unit]
Description=Run ailease cleanup periodically

[Timer]
OnBootSec=45s
OnUnitActiveSec=${REAPER_INTERVAL_SEC}s
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
EOF
      chmod 644 "$REAPER_SVC" "$REAPER_TIMER"
      rm -f "$REAPER_CRON"
    fi
    run systemctl daemon-reload
    run systemctl enable --now ailease-reaper.timer
    ok "到期回收器已启用：systemd timer（每 ${REAPER_INTERVAL_SEC}s）"
  else
    if [[ $DRY_RUN == no ]]; then
      cat >"$REAPER_CRON" <<EOF
# 由 ailease 生成 —— 每分钟回收到期容器与到期账号
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * root $SELF_DEST cleanup --quiet
EOF
      chmod 644 "$REAPER_CRON"
    fi
    ok "到期回收器已启用：cron（每分钟）"
  fi

  if [[ $DRY_RUN == no && -d /etc/logrotate.d ]]; then
    cat >"$LOGROTATE_CONF" <<EOF
$LOG_DIR/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
}
EOF
    chmod 644 "$LOGROTATE_CONF"
  fi
}

# ------------------------------------------------ 从旧的两个独立工具迁移
# 把 aiuser / aidocker 的数据、片段、回收器并到 ailease 名下
migrate_split_tools() {
  local moved=0 f base mf n p hm
  local -a old_timers=(
    /etc/systemd/system/aiuser-reaper.timer /etc/systemd/system/aidocker-reaper.timer
  )
  if [[ -f ${old_timers[0]} || -f ${old_timers[1]} ]]; then
    run systemctl disable --now aiuser-reaper.timer 2>/dev/null || true
    run systemctl disable --now aidocker-reaper.timer 2>/dev/null || true
    run rm -f /etc/systemd/system/aiuser-reaper.service /etc/systemd/system/aiuser-reaper.timer \
              /etc/systemd/system/aidocker-reaper.service /etc/systemd/system/aidocker-reaper.timer
    run systemctl daemon-reload 2>/dev/null || true
    moved=1
  fi
  [[ -f /etc/cron.d/aiuser   ]] && { run rm -f /etc/cron.d/aiuser;   moved=1; }
  [[ -f /etc/cron.d/aidocker ]] && { run rm -f /etc/cron.d/aidocker; moved=1; }
  run rm -f /etc/logrotate.d/aiuser /etc/logrotate.d/aidocker

  # 数据目录整体搬过来（目标已存在则不覆盖）
  if [[ -d /var/lib/aidocker/containers && ! -e $C_META_DIR ]]; then
    run mkdir -p "$LIB_DIR"; run mv /var/lib/aidocker/containers "$C_META_DIR"; moved=1
  fi
  if [[ -d /var/lib/aiuser/users && ! -e $H_USERS_DIR ]]; then
    run mkdir -p "$LIB_DIR"; run mv /var/lib/aiuser/users "$H_USERS_DIR"; moved=1
  fi
  if [[ -d /var/lib/aiuser/archive && ! -e $ARCHIVE_DIR ]]; then
    run mv /var/lib/aiuser/archive "$ARCHIVE_DIR"; moved=1
  fi

  shopt -s nullglob
  for f in /etc/sudoers.d/aiuser-*; do
    base="${f##*/aiuser-}"; run mv "$f" "/etc/sudoers.d/ailease-$base"; moved=1
  done
  for f in /etc/security/limits.d/aiuser-*.conf; do
    base="${f##*/aiuser-}"; run mv "$f" "/etc/security/limits.d/ailease-$base"; moved=1
  done
  # 旧的 sshd drop-in 一律清掉（新版改用 sshd_config 末尾受管块）
  for f in /etc/ssh/sshd_config.d/aiuser-*.conf /etc/ssh/sshd_config.d/aidocker-*.conf; do
    run rm -f "$f"; moved=1
  done
  shopt -u nullglob

  if [[ -e /usr/local/sbin/aiuser || -e /usr/local/sbin/aidocker || -e /usr/local/sbin/aiuser-rm ]]; then
    run rm -f /usr/local/sbin/aiuser /usr/local/sbin/aiuser-rm /usr/local/sbin/aidocker
    moved=1
  fi

  # sudoers 片段里写死的护栏路径要从 aiuser-rm 改成 ailease-rm，逐账号重生成
  shopt -s nullglob
  for mf in "$H_USERS_DIR"/*.meta; do
    [[ -s $mf ]] || continue
    n="$(sed -n "s/^NAME='\(.*\)'$/\1/p" "$mf" | head -n1)"
    [[ -n $n ]] || continue
    p="$(sed -n "s/^SUDO_PROFILE='\(.*\)'$/\1/p" "$mf" | head -n1)"
    gen_sudoers "$n" "${p:-minimal}"
    hm="$(sed -n "s/^HOME_DIR='\(.*\)'$/\1/p" "$mf" | head -n1)"
    if [[ -n $hm && -f "$hm/.bashrc" ]]; then
      run sed -i -e 's|AIUSER-BEGIN|AILEASE-BEGIN|' -e 's|AIUSER-END|AILEASE-END|' \
                   -e 's|/usr/local/sbin/aiuser-rm|/usr/local/sbin/ailease-rm|g' "$hm/.bashrc"
    fi
    moved=1
  done
  shopt -u nullglob

  if (( moved )); then
    ok "已从 aiuser / aidocker 迁移到 ailease（旧命令与旧回收器已移除）"
  fi
  return 0
}

# 剔除所有受管 SSH 块（含 aiuser 时代的标记），供迁移时重建
strip_all_sshd_blocks() {
  awk '
    /^# >>> (aiuser|ailease):.* >>>$/ {skip=1; next}
    /^# <<< (aiuser|ailease):.* <<<$/ {skip=0; next}
    skip!=1 {print}
  '
}

resync_sshd() {
  local mf
  [[ -f $SSHD_MAIN ]] || return 0
  if [[ $DRY_RUN == yes ]]; then
    printf '  %s[dry-run]%s 重建 SSH 收敛块 -> %s\n' "$C_D" "$C_0" "$SSHD_MAIN"
    return 0
  fi
  if grep -qE '^# >>> (aiuser|ailease):' "$SSHD_MAIN" 2>/dev/null; then
    local tmp="$SSHD_MAIN.ailease.$$"
    if strip_all_sshd_blocks <"$SSHD_MAIN" | trim_trailing_blanks >"$tmp"; then
      cp -f "$tmp" "$SSHD_MAIN"
    fi
    rm -f "$tmp"
  fi
  shopt -s nullglob
  for mf in "$H_USERS_DIR"/*.meta; do
    [[ -s $mf ]] || continue
    # shellcheck disable=SC1090
    ( . "$mf" 2>/dev/null; printf '%s %s\n' "${NAME:-}" "${STATUS:-}" ) \
      | while read -r n st; do
          [[ -n $n && $st == active ]] && gen_sshd "$n"
        done
  done
  shopt -u nullglob
}

# install [host|docker|all]
#   host（默认）  装主程序 + 宿主机账号模式：ailease-rm 护栏、回收器、SSH 收敛；不碰 docker
#   docker        在上面基础上再装 docker 引擎 + 基础镜像，启用容器模式
#   all           两者都装（等价 docker，因为 docker 版包含主程序）
cmd_install() {
  local target="${1:-host}"
  case "$target" in
    ""|host|script)   target="host" ;;
    docker|container) target="docker" ;;
    all|both)         target="all" ;;
    *) die "install 的目标只能是 host | docker | all（收到：$target）" ;;
  esac

  migrate_split_tools
  ensure_dirs
  if [[ $DRY_RUN == no ]]; then
    if [[ ! -f $CONF_FILE ]]; then
      cat >"$CONF_FILE" <<EOF
# ailease 全局默认（改完立即生效，无需重装）
DEFAULT_MODE="$DEFAULT_MODE"
DEFAULT_DURATION="$DEFAULT_DURATION"
DEFAULT_PROFILE="$DEFAULT_PROFILE"
DEFAULT_WORKROOT="$DEFAULT_WORKROOT"
DEFAULT_SHELL="$DEFAULT_SHELL"
PURGE_ON_EXPIRE="$PURGE_ON_EXPIRE"
KILL_ON_EXPIRE="$KILL_ON_EXPIRE"
REAPER_INTERVAL_SEC=$REAPER_INTERVAL_SEC
INSTALL_DOCKER="$INSTALL_DOCKER"
DEFAULT_MEM="$DEFAULT_MEM"
DEFAULT_CPUS="$DEFAULT_CPUS"
DEFAULT_PIDS="$DEFAULT_PIDS"
DEFAULT_IMAGE="$BUILTIN_IMAGE"
DEFAULT_BIND="$DEFAULT_BIND"
EOF
      chmod 640 "$CONF_FILE"
      ok "默认配置 -> $CONF_FILE"
    else
      # 脚本里的默认镜像可能变了，同步进旧配置，否则已装过的机器一直抱着老镜像名
      local cur
      cur="$(grep '^DEFAULT_IMAGE=' "$CONF_FILE" | head -n1 | cut -d= -f2- | tr -d '"')"
      if [[ -n $cur && $cur != "$BUILTIN_IMAGE" ]]; then
        sed -i "s|^DEFAULT_IMAGE=.*|DEFAULT_IMAGE=\"$BUILTIN_IMAGE\"|" "$CONF_FILE"
        DEFAULT_IMAGE="$BUILTIN_IMAGE"
        info "默认镜像已更新：$cur -> $BUILTIN_IMAGE"
      fi
    fi

    local self=""
    self="$(self_path 2>/dev/null || true)"
    if [[ $self == "$SELF_DEST" ]]; then
      : # 已在目标位置
    elif [[ -n $self ]]; then
      install -m 755 "$self" "$SELF_DEST"
      ok "主程序 -> $SELF_DEST"
    else
      info "从 $SELF_URL 获取主程序"
      local tmp="$SELF_DEST.tmp.$$"
      if need_cmd curl; then
        curl -fsSL -m 60 "$SELF_URL" -o "$tmp" || die "下载失败：$SELF_URL"
      elif need_cmd wget; then
        wget -qO "$tmp" "$SELF_URL" || die "下载失败：$SELF_URL"
      else
        die "需要 curl 或 wget 才能把自己装到 $SELF_DEST"
      fi
      [[ -s $tmp ]] || { rm -f "$tmp"; die "下载到的内容为空：$SELF_URL"; }
      chmod 755 "$tmp"; mv -f "$tmp" "$SELF_DEST"
      ok "主程序 -> $SELF_DEST（从 $SELF_URL 下载）"
    fi
  fi

  emit_ai_rm
  install_reaper
  resync_sshd

  if [[ $target == host ]]; then
    info "只装了主程序与账号模式；容器模式用 ailease install docker 启用"
    ok "安装完成（账号版）。下一步：sudo ailease new ai /clicd 2h --host"
  elif [[ $WANT_DOCKER == no ]]; then
    info "--no-docker：跳过 docker 与基础镜像"
    ok "安装完成（账号版）"
  elif install_docker; then
    build_base_image "$DEFAULT_IMAGE"
    ok "安装完成（docker 版 + 账号版）。下一步：sudo ailease new ai /clicd 2h"
  else
    warn "docker 不可用：容器模式暂不可用，用 --host 走宿主机账号模式"
    ok "安装完成（账号版）"
  fi
}

cmd_uninstall() {
  local all=0
  while (( $# )); do case "$1" in --all) all=1; shift ;; *) die "未知参数：$1" ;; esac; done
  need_cmd systemctl && run systemctl disable --now ailease-reaper.timer 2>/dev/null || true
  run rm -f "$REAPER_SVC" "$REAPER_TIMER" "$REAPER_CRON" "$LOGROTATE_CONF" "$AIRM_DEST"
  need_cmd systemctl && run systemctl daemon-reload 2>/dev/null || true
  if (( all )); then
    local f n
    if docker_ok; then
      shopt -s nullglob
      for f in "$C_META_DIR"/*.meta; do
        # shellcheck disable=SC1090
        ( . "$f" 2>/dev/null; echo "${C_NAME:-}" ) | while read -r n; do
          [[ -n $n ]] && dc_del "$n" -y
        done
      done
      shopt -u nullglob
    fi
    shopt -s nullglob
    for f in "$H_USERS_DIR"/*.meta; do
      # shellcheck disable=SC1090
      ( . "$f" 2>/dev/null; echo "${NAME:-}" ) | while read -r n; do
        [[ -n $n ]] && hu_revoke "$n" --purge
      done
    done
    shopt -u nullglob
  fi
  ok "回收器与护栏已卸载（配置与元数据保留在 $LIB_DIR / $CONF_DIR）"
}

cmd_check() {
  local rc=0

  echo "== docker / 容器模式 =="
  if need_cmd docker; then
    printf '  %sok%s   docker 已安装：%s\n' "$C_G" "$C_0" "$(docker --version 2>/dev/null)"
    if docker info >/dev/null 2>&1; then
      printf '  %sok%s   守护进程可连接\n' "$C_G" "$C_0"
      printf '  %s信息%s   storage-driver=%s cgroup=%s\n' "$C_B" "$C_0" \
        "$(docker info -f '{{.Driver}}' 2>/dev/null)" "$(docker info -f '{{.CgroupVersion}}' 2>/dev/null)"
      if docker image inspect "$DEFAULT_IMAGE" >/dev/null 2>&1; then
        printf '  %sok%s   基础镜像：%s\n' "$C_G" "$C_0" "$DEFAULT_IMAGE"
      else
        printf '  %s危%s   基础镜像缺失：%s（跑 install）\n' "$C_R" "$C_0" "$DEFAULT_IMAGE"; rc=1
      fi
    else
      printf '  %s危%s   连不上守护进程（容器模式不可用，--host 仍可用）\n' "$C_R" "$C_0"; rc=1
    fi
  else
    printf '  %s危%s   未安装 docker（容器模式不可用，--host 仍可用）\n' "$C_R" "$C_0"; rc=1
  fi

  echo "== 宿主机账号模式 =="
  local c
  for c in useradd usermod userdel chage chpasswd passwd visudo setfacl getfacl tar; do
    if need_cmd "$c"; then printf '  %sok%s   %s\n' "$C_G" "$C_0" "$c"
    else printf '  %s缺%s   %s\n' "$C_R" "$C_0" "$c"; rc=1; fi
  done
  need_cmd sshd || warn "未检测到 sshd（跳过 SSH 相关检查）"

  echo "== 关键文件权限 =="
  local perms
  perms="$(stat -c '%a' /etc/shadow 2>/dev/null || echo '?')"
  if [[ $perms == 600 || $perms == 640 || $perms == 000 ]]; then
    printf '  %sok%s   /etc/shadow = %s\n' "$C_G" "$C_0" "$perms"
  else
    printf '  %s危%s   /etc/shadow = %s（应 <= 640）\n' "$C_R" "$C_0" "$perms"; rc=1
  fi
  grep -qE '^[[:space:]]*(@|#)?[[:space:]]*includedir[[:space:]]+/etc/sudoers\.d' /etc/sudoers 2>/dev/null \
    && printf '  %sok%s   sudoers 已 include /etc/sudoers.d\n' "$C_G" "$C_0" \
    || { printf '  %s危%s   sudoers 未 include /etc/sudoers.d，sudo 片段不会生效\n' "$C_R" "$C_0"; rc=1; }

  echo "== 家目录隔离（POSIX ACL 无法拒绝，只能靠默认权限）=="
  local d m
  for d in /home/*/; do
    [[ -d $d ]] || continue
    m="$(stat -c '%a' "$d")"
    if [[ $m =~ ^7 && ${#m} -eq 3 ]]; then
      printf '  %s危%s   %s = %s（其他用户可进入）\n' "$C_R" "$C_0" "$d" "$m"; rc=1
    fi
  done
  echo "  提示：/etc、/var/log 等系统目录天生 world-readable，ACL 只能『授权』不能『禁止』。"
  echo "        要强隔离请用容器模式（ailease new 默认）或独立 VM。"

  echo "== 回收器 =="
  if need_cmd systemctl && systemctl is-active --quiet ailease-reaper.timer 2>/dev/null; then
    printf '  %sok%s   systemd timer 运行中\n' "$C_G" "$C_0"
  elif [[ -f $REAPER_CRON ]]; then
    printf '  %sok%s   cron 已安装\n' "$C_G" "$C_0"
  else
    printf '  %s危%s   回收器未安装，到期不会自动回收（跑 install）\n' "$C_R" "$C_0"; rc=1
  fi

  echo "== 受管对象 =="
  local f nc=0 nh=0
  shopt -s nullglob
  for f in "$C_META_DIR"/*.meta; do
    nc=$(( nc + 1 ))
    # shellcheck disable=SC1090
    ( . "$f" 2>/dev/null; printf '  容器  %-14s %-10s dir=%s\n' "${C_NAME:-?}" "${C_STATUS:-?}" "${C_DIR:-?}" )
  done
  for f in "$H_USERS_DIR"/*.meta; do
    nh=$(( nh + 1 ))
    # shellcheck disable=SC1090
    ( . "$f" 2>/dev/null; printf '  账号  %-14s %-10s dir=%s\n' "${NAME:-?}" "${STATUS:-?}" "${WORKDIR:-?}" )
  done
  shopt -u nullglob
  echo "  合计：容器 $nc 个 / 账号 $nh 个"
  return $rc
}

# =============================================================================
#  用法
# =============================================================================
usage() {
  cat <<EOF
ailease $VERSION — 一次性 AI 环境管理器（容器优先，宿主机账号兜底）

用法：sudo $0 <子命令> [选项]

最常用
  sudo $0 new ai /clicd 2h        起一个容器：挂 /clicd，2 小时，容器内 root
  sudo $0 new ai /clicd 2h --host 同上，但建宿主机账号（ACL + sudo 白名单）
  sudo $0 del ai                  删掉（容器删容器；账号归档家目录后删）

首次使用先装
  sudo $0 install                 装主程序 + 账号版（不碰 docker）
  sudo $0 install docker          再装 docker 引擎 + 基础镜像，启用容器版
  两个版本同一套命令与参数；new 时自动判断用哪个（docker 可用走容器，否则走账号）

子命令
  new <名字> [目录] [时长] [档位] [选项]   建环境；自动选版本，--host / --container 可强制
                                   两版参数一致：目录、时长、档位（账号版用，容器版忽略）
                                   容器专属：--ro --public --readonly --pubkey-file=
                                             --password= --pubkey= --user= --image= --mem= --cpus= --pids=
  create --name N [选项]           完整版账号创建（等价 --host 的细调版，见 aiuser 文档）
  install [host|docker|all]        装主程序 / docker 版 / 两者；默认 host
  uninstall [--all]                卸载回收器与护栏（--all 连同容器与账号一起清）
  list                             列出容器与账号
  status <名字>                    查看详情（自动识别容器/账号）
  exec <名字> [命令]               进容器（等同 docker exec -it）
  extend <名字> <时长>             延长（容器会重新 start，账号会解锁）
  del <名字> [-y]                  删除（容器：删容器；账号：归档家目录后删账号）
  revoke <名字> [--purge]          只吊销账号（锁号不删；--purge 才删）
  fixacl [名字]                    重放账号目录授权（装完 acl 包后用）
  cleanup                          手动跑一次到期回收（容器 + 账号）
  check                            环境自检

镜像离线分发（容器模式）
  export [文件]                    导出基础镜像，供离线分发
  import <文件>                    导入基础镜像（小内存机器免构建）

全局
  --dry-run    只打印将要执行的动作，不落盘
  --quiet      安静模式
  -V, --version

时长：30m 2h 12h 7d 2w 1h30m；容器模式另支持 never（永不过期）
版本自动判断：docker 可用走容器，否则走账号；--host / --container 可强制
（默认版本见 /etc/ailease/config 里的 DEFAULT_MODE）

示例
  sudo $0 new ai /clicd 2h                       # 容器，最常用
  sudo $0 new ai /clicd 7d --mem=4g --cpus=4     # 容器，大活
  sudo $0 new ai /srv/data 12h --ro              # 容器，只读挂载
  sudo $0 new ai /clicd 2h --host dev            # 宿主机账号 + 开发档 sudo
  sudo $0 new ai /clicd 2h --host none           # 宿主机账号，不给 sudo
  sudo $0 exec ai
  sudo $0 extend ai 1h
  sudo $0 del ai -y
EOF
}

# =============================================================================
#  调度
# =============================================================================

# new 的模式选择：默认容器；--host 强制账号；docker 不可用时回退账号模式
cmd_new() {
  local mode="$DEFAULT_MODE" want=0   # want: 0 未指定 / 1 强制账号 / 2 强制容器
  local -a rest=()
  local a
  for a in "$@"; do
    case "$a" in
      --host) want=1 ;;
      --container|--docker) want=2 ;;
      *) rest+=("$a") ;;
    esac
  done
  if   (( want == 1 )); then mode=host
  elif (( want == 2 )); then mode=container
  fi
  [[ $mode == auto ]] && mode=container   # auto：先按容器试，docker 不可用再回退

  if [[ $mode == host ]]; then
    hu_new "${rest[@]+"${rest[@]}"}"
    return 0
  fi
  if ! docker_ok; then
    if (( want == 2 )); then
      die "docker 不可用（先跑 install docker，或去掉 --container 用 --host）"
    fi
    warn "docker 不可用，回退到账号版（sudo ailease install docker 可启用容器版）"
    hu_new "${rest[@]+"${rest[@]}"}"
    return 0
  fi
  dc_new "${rest[@]+"${rest[@]}"}"
}

cmd_list() {
  log "== 容器 =="
  if docker_ok; then dc_list; else log "（docker 不可用，跳过）"; fi
  echo
  log "== 宿主机账号 =="
  hu_list
}

cmd_status() {
  local n="${1:-}"
  [[ -n $n ]] || die "用法：status <名字>"
  if dc_is_managed "$n"; then dc_status "$n"
  elif hu_is_managed "$n"; then hu_status "$n"
  else die "找不到受管对象：$n（先 list 看看）"; fi
}

cmd_extend() {
  local n="${1:-}" d="${2:-}"
  [[ -n $n && -n $d ]] || die "用法：extend <名字> <时长>"
  if dc_is_managed "$n"; then require_docker; dc_extend "$n" "$d"
  elif hu_is_managed "$n"; then hu_extend "$n" "$d"
  else die "找不到受管对象：$n"; fi
}

cmd_del() {
  local n="${1:-}"; shift || true
  [[ -n $n ]] || die "用法：del <名字> [-y]"
  if dc_is_managed "$n"; then require_docker; dc_del "$n" "$@"
  elif hu_is_managed "$n"; then hu_del "$n" "$@"
  else die "找不到受管对象：$n"; fi
}

cmd_cleanup() {
  if docker_ok; then dc_cleanup; else info "docker 不可用，跳过容器回收"; fi
  hu_cleanup
}

main() {
  local -a argv=()
  while (( $# )); do
    case "$1" in
      --dry-run) DRY_RUN=yes; shift ;;
      --quiet)   QUIET=yes; shift ;;
      --no-docker) WANT_DOCKER=no; shift ;;
      --version|-V) echo "$VERSION"; exit 0 ;;
      *) argv+=("$1"); shift ;;
    esac
  done
  set -- "${argv[@]+"${argv[@]}"}"

  local sub="${1:-}"
  # 管道执行（wget … | bash）且没给子命令时，默认做 install
  if [[ -z $sub ]] && ! self_path >/dev/null 2>&1; then
    sub="install"
  fi

  case "$sub" in
    ""|-h|--help|help) usage; exit 0 ;;
    install)   require_root; shift; cmd_install "${1:-host}" ;;
    uninstall) require_root; shift; cmd_uninstall "$@" ;;
    check)     require_root; cmd_check ;;
    list|ls)   require_root; cmd_list ;;
    status)    require_root; shift; cmd_status "$@" ;;
    cleanup)   require_root; cmd_cleanup ;;
    export|save) require_root; require_docker; shift; dc_export "$@" ;;
    import|load) require_root; require_docker; shift; dc_import "$@" ;;
    exec)      require_root; require_docker; shift; dc_exec "$@" ;;
    revoke)    require_root; ensure_dirs; lock; shift; hu_revoke "$@" ;;
    fixacl)    require_root; ensure_dirs; lock; shift; hu_fixacl "$@" ;;
    create)    require_root; ensure_dirs; lock; shift; hu_create "$@" ;;
    new|add|run|mk)
      require_root; ensure_dirs; lock
      shift; cmd_new "$@" ;;
    extend)
      require_root; ensure_dirs; lock
      shift; cmd_extend "$@" ;;
    del|delete|remove)
      require_root; ensure_dirs; lock
      shift; cmd_del "$@" ;;
    *) die "未知子命令：$sub（-h 查看用法）" ;;
  esac
}

main "$@"
